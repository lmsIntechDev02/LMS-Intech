    [HR_Monthly_Leaves_Report].[UserName] AS [UserName], 
    [HR_Monthly_Leaves_Report].[LeaveType] AS [LeaveType], 
    [HR_Monthly_Leaves_Report].[Reason] AS [Reason], 
    [HR_Monthly_Leaves_Report].[StartDate] AS [StartDate], 
    [HR_Monthly_Leaves_Report].[EndDate] AS [EndDate], 
    [HR_Monthly_Leaves_Report].[TotalDays] AS [TotalDays], 
    [HR_Monthly_Leaves_Report].[EmergencyContact] AS [EmergencyContact], 
    [HR_Monthly_Leaves_Report].[HrManager] AS [HrManager], 
    [HR_Monthly_Leaves_Report].[ManagerOne] AS [ManagerOne], 
    [HR_Monthly_Leaves_Report].[ManagerTwo] AS [ManagerTwo], 
    [HR_Monthly_Leaves_Report].[IsAcceptedHr] AS [IsAcceptedHr], 
    [HR_Monthly_Leaves_Report].[IsAccepted1] AS [IsAccepted1], 
    [HR_Monthly_Leaves_Report].[IsAccepted2] AS [IsAccepted2], 
    [HR_Monthly_Leaves_Report].[RemarksHr] AS [RemarksHr], 
    [HR_Monthly_Leaves_Report].[Remarks1] AS [Remarks1], 
    [HR_Monthly_Leaves_Report].[Remarks2] AS [Remarks2], 
    [HR_Monthly_Leaves_Report].[DateCreated] AS [DateCreated]
    FROM [dbo].[HR_Monthly_Leaves_Report] AS [HR_Monthly_Leaves_Report]</DefiningQuery>
