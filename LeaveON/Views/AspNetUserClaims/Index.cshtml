@model IEnumerable<Repository.Models.AspNetUserClaim>

@{
  ViewBag.Title = "Access Rights";
  Layout = "~/Views/Shared/_Layout.cshtml";
}




 
 

  <!-- left column -->
<div class="col-md-6">
  <!-- general form elements -->
  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">Access Rights</h3>
    </div>
    @using (Html.BeginForm("Index", "AspNetUserClaims"))
    {
      @Html.AntiForgeryToken()
      <div class="card-body">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.DropDownList("UserId", (IEnumerable<SelectListItem>)ViewBag.Employees, null, new { @class = "form-control dropdown" })
        @Html.DropDownList("ClaimValue", (IEnumerable<SelectListItem>)ViewBag.Departments, null, new { @class = "form-control dropdown" })
        </div>
        <div class="form-group">
          <div class="col-md-offset-2 col-md-1 AddClaim">
            <input type="submit" value="Add" class="btn btn-primary add_btn" />
          </div>
        </div>
        }
        <section class="content">
          <div class="row">
            <div class="col-12">
              <div class="card-body">
                <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
                  <div class="row">
                    <div class="col-sm-12 col-md-6">
                    </div>
                    <div class="col-sm-12 col-md-6"></div>
                  </div>
                  <div class="row">
                    <div class="col-sm-12">
                      @using (Html.BeginForm("DeleteClaim", "AspNetUserClaims"))
                      {
                        @Html.AntiForgeryToken()

                        <table id="example2" class="table table-bordered table-hover dataTable dtr-inline" role="grid" aria-describedby="example2_info">
                          <thead>
                            <tr role="row">

                              <th>
                                User
                              </th>
                              <th>
                                Department
                              </th>
                              <th></th>
                            </tr>
                          </thead>
                          @foreach (var item in Model)
                          {
                            <tr>
                              @*<td style="display:none;"><input type="hidden" name="AnnualOffDay.Index" value="@(counter)" /></td>*@
                              @*<td>
                                @Html.HiddenFor(modelItem => item.UserId)
                              </td>*@
                              <td>
                                @Html.DisplayFor(modelItem => item.AspNetUser.UserName)
                              </td>
                              <td>
                                @Html.DisplayFor(modelItem => item.ClaimType)
                              </td>

                              <td>
                                @*@Html.ActionLink("Delete", "Delete", new { id = item.Id })*@
                                @*<input type="submit" Class="DeleteClaim" name="AspNetUserClaim.ClaimType" id="Delete@(item.Id)" value="Delete@(item.Id)" class="btn btn-danger" />*@
                                <div class="form-group">
                                  <div class="col-md-offset-2 col-md-10">
                                    @*<input type="submit" value="Add" class="btn btn-primary" />*@
                                    <button type="submit" title="Delete" Class="btn btn-danger DeleteClaim" name="ClaimId" id="Delete@(item.Id)" value="@(item.Id)">X</button>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          }
                        </table>
                      }
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
<script>
  $(".DeleteClaim").on('click', function () {
    if (!confirm('Are you sure?')) {
      return false;
    }
  });
  //
  $(".AddClaim").on('click', function () {
    if (!confirm('Are you sure?')) {
      return false;
    }
  });
   $(function () {
    $('#example2').DataTable({
      "paging": false,
      "lengthChange": false,
      "searching": true,
      "ordering": true,
      "info": false,
      "autoWidth": false,
      "responsive": true,
    });
  });
</script>

<style>
  .add_btn {
    padding: 10px 25px;
    text-align: center;
    margin-left: 15px;
  }

  .form-control {
    height: 40px;
  }
  .dropdown {
    height: 45px !important;
    margin-bottom: 10px;
  }
</style>
 
