<!-- page script -->
<script>
    $(document).ready(function () {

        $('#example2').DataTable({

            processing: true,
            serverSide: true,

            ajax: {
                url: '@Url.Action("GetQuotaRequestHistory", "LeavesRequest")',
                type: 'POST'
            },

            pageLength: 10,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            searching: true,
            ordering: true,
            responsive: true,

            order: [[0, "desc"]],

            columns: [

                {
                    data: "RequestDate",
                    render: function (data) {

                        if (!data)
                            return "";

                        var date = new Date(parseInt(data.replace("/Date(", "").replace(")/", "")));

                        return date.toLocaleDateString();
                    }
                },

                {
                    data: "StartDate",
                    render: function (data) {

                        if (!data)
                            return "";

                        var date = new Date(parseInt(data.replace("/Date(", "").replace(")/", "")));

                        return date.toLocaleDateString();
                    }
                },

                {
                    data: "EndDate",
                    render: function (data) {

                        if (!data)
                            return "";

                        var date = new Date(parseInt(data.replace("/Date(", "").replace(")/", "")));

                        return date.toLocaleDateString();
                    }
                },

                {
                    data: "LeaveType"
                },

                {
                    data: "TotalDays"
                },

                {
                    data: "Reason"
                },

                {
                    data: null,

                    render: function (data, type, row) {

                        if (row.IsAccepted1 != null &&
                            row.IsAccepted1 > 0) {

                            return '<span style="color:green">' +
                                   '<b>Approved</b>' +
                                   '</span><br />' +
                                   '<span style="color:green;font-size:80%;">' +
                                   (row.Remarks1 || '') +
                                   '</span>';
                        }

                        if (row.IsAccepted1 != null &&
                            row.IsAccepted1 == 0) {

                            return '<span style="color:red">' +
                                   '<b>Refused</b>' +
                                   '</span><br />' +
                                   '<span style="color:red;font-size:80%;">' +
                                   (row.Remarks1 || '') +
                                   '</span>';
                        }

                        return '';
                    }
                },

                {
                    data: null,

                    render: function (data, type, row) {

                        if (row.IsAccepted2 != null &&
                            row.IsAccepted2 > 0) {

                            return '<span style="color:green">' +
                                   '<b>Approved</b>' +
                                   '</span><br />' +
                                   '<span style="color:green;font-size:80%;">' +
                                   (row.Remarks2 || '') +
                                   '</span>';
                        }

                        if (row.IsAccepted2 != null &&
                            row.IsAccepted2 == 0) {

                            return '<span style="color:red">' +
                                   '<b>Refused</b>' +
                                   '</span><br />' +
                                   '<span style="color:red;font-size:80%;">' +
                                   (row.Remarks2 || '') +
                                   '</span>';
                        }

                        return '';
                    }
                },

                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function (data, type, row) {

                        return '';
                    }
                }

            ]

        });

    });
</script>

