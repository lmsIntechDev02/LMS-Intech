@model IEnumerable<Repository.Models.Leave>

@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

 

<section class="content">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">

        <h3 class="dashboard-title my-2">  My Leaves History </h3>
        @Html.ActionLink("Apply Leave", "Create")
      </div>
      <div class="card">



        <div class="card-body">
          @*@Html.ActionLink("Register User", "Register","Account")*@
          <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
            <div class="row">
              <div class="col-sm-12 col-md-6">
              </div>
              <div class="col-sm-12 col-md-6"></div>
            </div>
            <div class="row">
              <div class="col-sm-12">
                <table id="example2" class="table table-bordered table-hover dataTable dtr-inline">
                  <thead>
                    <tr>
                      <th style="display:none;">Id</th>
                      <th>Request Date</th>
                      <th>Start Date</th>
                      <th>End Date</th>
                      <th>Leave Type</th>
                      <th>Days/Hours</th>
                      <th>Reason</th>
                      <th>Line Manager 1</th>
                      <th>Line Manager 2</th>

                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>




              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


</section>

 

 
<script>
  $(function () {

    $('#example2').DataTable({

        processing: true,
        serverSide: true,
        searching: true,
        ordering: true,
      pageLength: 10,
      responsive: true,
      autoWidth: false,

        ajax: {
            url: '@Url.Action("GetLeaveHistory", "LeavesRequest")',
            type: 'POST'
      },
        columns: [
         
        {
          data: 'DateCreated',
          render: function (data) {
            return data ? moment(data).format('MM/DD/YYYY') : '';
          }
        },
        {
          data: 'StartDate',
          render: function (data) {
            return data ? moment(data).format('MM/DD/YYYY') : '';
          }
        },
        {
          data: 'EndDate',
          render: function (data) {
            return data ? moment(data).format('MM/DD/YYYY') : '';
          }
        },
        {
          data: 'LeaveTypeName'
          },

          {
            data: null,
            render: function (data, type, row) {

              if (row.IsShortLeave == false) {
                return `${row.TotalDays} Day(s)`;
              }
              else {
                return `${row.TotalHours} Hour(s)`;
              }



              return '';
            }
          },
        {
          data: 'Reason'
        },
        {
          //data: 'ApprovalStatus1'
          data: null,
          render: function (data, type, row) {


              return `
                            <p style="color:green">
                                <b>${row.ApprovalStatus1}</b>
                            </p>
                            <p style="color:green;font-size:80%;">
                                ${row.remarks1 || ''}
                            </p>`;





          }
          },
          {
            //data: 'ApprovalStatus1'
            data: null,
            render: function (data, type, row) {


              return `
                            <p style="color:green">
                                <b>${row.ApprovalStatus2}</b>
                            </p>
                            <p style="color:green;font-size:80%;">
                                ${row.Remarks2 || ''}
                            </p>`;





            }
          },


        //{
        //    data: 'Id',
        //    orderable: false,
        //    searchable: false,
        //  render: function (data)
        //  {

        //        return '';
        //    }
        //}
    ],



        order: [[1, 'desc']],

        responsive: true,

        language: {
            processing: "Loading..."
        }
    });


  });
</script>

