

@model IEnumerable<LeaveON.Models.HRBPModel>

@{
  ViewBag.Title = "HRBP List";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

 <style>
   .card-body::after, .card-footer::after, .card-header::after {
     display: unset;
     clear: unset;
     content: unset;
   }
 </style>



<!-- DataTables -->
<link rel="stylesheet" href="../../plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">



<!-- DataTables -->
<script src="../../plugins/datatables/jquery.dataTables.min.js"></script>
<script src="../../plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>


<section class="content">
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="card-title">HRBP List  </h3>

          @Html.ActionLink("Create New", "AddEdit", null,
                   new { @class = "btn btn-primary text-right" })
        </div>


        <div class="card-body">
          @*@Html.ActionLink("Create New", "Create")*@
          <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
            <div class="row">
              <div class="col-sm-12 col-md-6">
              </div>
              <div class="col-sm-12 col-md-6"></div>
            </div>
            <div class="row">
              <div class="col-sm-12">
                <table id="example2" class="table table-bordered table-hover dataTable dtr-inline" role="grid" aria-describedby="example2_info">
                  <thead>
                    <tr role="row">
                      <th>HRBP ID</th>
                      <th>Name</th>
                      <th>Email</th>
                      <th>HRBP Status</th>
                      
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    @foreach (var item in Model )
                    {
              <tr>
                <td>@item.HRBPID</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>
                  @(item.IsActive.Value ? "Active" : "In-Active")
                </td>
                
                <td>
                  @Html.ActionLink("Edit", "AddEdit",
                                new { id = item.HRBPID },
                                new { @class = "btn btn-sm btn-warning" })


                  @*@Html.ActionLink("Delete", "Delete",
                                new { id = item.HRBPID },
                                new { @class = "btn btn-sm btn-danger" })*@
                </td>
              </tr>}
                  </tbody>
                  <tfoot>

                  </tfoot>

                </table>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- page script -->
<script>
  $(function () {
    $("#example1").DataTable({
      "responsive": true,
      "autoWidth": false,
    });
    $('#example2').DataTable({
      "paging": false,
      "lengthChange": false,
      "searching": true,
      "ordering": true,
      "info": false,
      "autoWidth": false,
      "responsive": true,
    });
  });
</script>










