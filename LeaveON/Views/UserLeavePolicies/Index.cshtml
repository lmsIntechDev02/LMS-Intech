@model IEnumerable<Repository.Models.UserLeavePolicy>

@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
 
@if (TempData["success"] != null)
{
  <script>
        toastr.success("@TempData["success"]");
  </script>
}

@if (TempData["error"] != null)
{
  <script>
        toastr.error("@TempData["error"]");
  </script>
}
<section class="content">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center my-2">

        <h3 class="dashboard-title my-2">User Leave Policies</h3>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
      </div>
      <div class="card">
         
        <div class="card-body">
      
          <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
            <div class="row">
              <div class="col-sm-12 col-md-6">
              </div>
              <div class="col-sm-12 col-md-6"></div>
            </div>
            <div class="row">
              <div class="col-sm-12">

                <table id="example2"  class="table table-bordered table-hover" role="grid" aria-describedby="example2_info">
                  <thead>
                    <tr role="row">
                     
                      <th class="sorting_desc" tabindex="0" aria-controls="example2" rowspan="1" colspan="1" aria-label="FiscalYearStart: activate to sort column ascending">
                        @Html.DisplayNameFor(model => model.Description)
                      </th>
                      

                      

                    </tr>
                  </thead>
                  @foreach (var item in Model)
                  {
                    <tr>
                   
                      <td>
                        @Html.DisplayFor(modelItem => item.Description)
                      </td>
                     
                      <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id, Caller = "UserLeavePolicy" }) |
                        @*@Html.ActionLink("Details", "Details", new { id = item.Id }) |*@
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }) |


                        <a href="/UserLeavePolicies/ResetLeavePolicyValues?id=@item.Id">Close Policy</a>

                      </td>
                    </tr>
                  }
                  <tfoot>
                    <tr role="row">
                     
                    </tr>
                  </tfoot>


                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<script>

  $('#example2').DataTable({
    "paging": false,
    "lengthChange": false,
    "searching": true,
    "ordering": true,
    "info": false,
    "autoWidth": false,
    "responsive": true,
  });
  });
</script>
