@model IEnumerable<TimeManagement.Models.UD_TB_AccessTime_Data>
@using System.Globalization


@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}


@*<h2>Index</h2>

  <p>
    @Html.ActionLink("Create New", "Create")
  </p>*@
<div>
  @Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartments), htmlAttributes: new { @class = "selectpicker department-drodown", @id = "listDepartments", data_live_search = "true", data_actions_box = "true", data_done_button = "true", data_width = "100px" })
  @Html.DropDownList("EmployeeList", new MultiSelectList(ViewBag.Employees, "Value", "Text", ViewBag.SelectedEmployees), htmlAttributes: new { @class = "selectpicker", @id = "listEmployees", data_live_search = "true", data_actions_box = "true", data_done_button = "true", style = "display:none" })


  <div id="listEmployees" class="dropdown-check-list employee-dropdown-width">
    <span class="anchor">Select Employees</span>
    <ul class="items">
      <li>
        <label for="selectAllEmployees">
          <input type="checkbox" id="selectAllEmployees" checked /> Select All Employees
        </label>
      </li>
      @foreach (var employee in ViewBag.Employees as IEnumerable<SelectListItem>)
      {
        var username = employee.Text.Split('@')[0].Replace(".", " ");
        var empName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(username.ToLower());

        <li>
          <label for="emp_@employee.Value">
            <input type="checkbox" value="@employee.Value" id="emp_@employee.Value" class="employeeCheckbox" checked /> @empName
          </label>
        </li>
      }
    </ul>
  </div><SelectListItem>



    @Html.Editor("startDate", new { htmlAttributes = new { @class = "datepicker", @id = "datepickerStart", @placeholder = "Start date", @Value = ViewBag.StartDate, autocomplete = "off" } })


    @*@Html.Label("Time", htmlAttributes: new { @class = "control-label col-md-2" })*@

    @Html.Editor("endDate", new { htmlAttributes = new { @class = "datepicker", @id = "datepickerEnd", @placeholder = "End date", @Value = ViewBag.EndDate, autocomplete = "off" } })


    @*<button id="load">go</button>*@
    <button id="load" style="position: relative;">
      <span class="button-text">Go</span>
      <span class="loader" style="display: none;">Loading...</span>
    </button>

    @{Html.RenderPartial("_AbsenteesData_UserWise", Model); }
</div>



<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css" integrity="sha512-ELV+xyi8IhEApPS/pSj66+Jiw+sOT1Mqkzlh8ExXihe4zfqbWkxPRi8wptXIO9g73FSlhmquFlUOuMSoXz5IRw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js" integrity="sha512-57oZ/vW8ANMjR/KQ6Be9v/+/h6bq9/l3f0Oc7vn6qMqyhvPd1cvKBRWWpzu0QoneImqr2SkmO4MSqU+RpHom3Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>



<script type="text/javascript">

        $(document).ready(function () {
          $(".dropdown-check-list .anchor").click(function (e) {
            var checkList = $(this).parent();
            checkList.toggleClass('visible');
            e.stopPropagation();
          });

          $('.datepicker').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 1,
            maxDate: new Date(),
            onSelect: function (selectedDate) {
              // Enable the end date picker after the start date is selected
              $('#datepickerEnd').datepicker("option", "minDate", selectedDate);
              $('#datepickerEnd').prop('disabled', false);
            }
          });

          // Initialize the end date picker (disabled initially)
          $('#datepickerEnd').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 1
          }).prop('disabled', true);

          // Close dropdown when clicking outside
          $(document).click(function (e) {
            if (!$(e.target).closest('.dropdown-check-list').length) {
              $(".dropdown-check-list").removeClass('visible');
            }
          })


          // Handle Select All functionality
          $('#selectAllEmployees').change(function () {
            var isChecked = $(this).is(':checked');
            // Toggle all employee checkboxes based on the state of "Select All"
            $('#listEmployees .employeeCheckbox').prop('checked', isChecked);
          });

          function capitalizeFirstLetterOfEachWord(str) {
            return str.split(' ').map(function (word) {
              return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
            }).join(' ');
          }

          $("#listDepartments").change(function () {
            //DepartmentName = $('#yourslectbox').find(":selected").text();
            //alert('abc');
            var DepartmentName = $('#listDepartments').val();
            $("#listEmployees").empty();
            $.ajax({
              type: 'POST',
              url: "@Url.Action("GetThisDepEmpsData", "AccessBiostarTA")",
              dataType: 'json',
              data: { 'DepartmentName': DepartmentName },
              success: function (data) {
                var employeeList = $("#listEmployees ul.items");
                employeeList.empty();

                // Add "Select All Employees" checkbox for the current department employees
                var selectAllHtml = '<li><label for="selectAllEmployees"><input type="checkbox" id="selectAllEmployees" /> Select All Employees</label></li>';
                employeeList.append(selectAllHtml);

                $.each(data, function (index, item) {
                  var empName = item.Text.split('@@')[0].replace(/\./g, ' ');
                  var userName = capitalizeFirstLetterOfEachWord(empName);

                  employeeList.append($('<li>').html(
                    '<label for="emp_' + item.Value + '">' +
                    '<input type="checkbox" value="' + item.Value + '" id="emp_' + item.Value + '" class="employeeCheckbox" /> ' +
                    userName +
                    '</label>'
                  ));
                });
                // Automatically select all employees if any department is selected
                $('#selectAllEmployees').prop('checked', true);
                $('#listEmployees input.employeeCheckbox').prop('checked', true);
                // Re-attach change event for "Select All Employees"
                attachSelectAllEvent();
            },
              error: function (ex) {
              alert('Failed To Retive Products' + ex);
            }
            });
              return false;
          })

          // Handle individual checkbox changes to update "Select All" state
          $('#listEmployees').on('change', '.employeeCheckbox', function () {
            var allChecked = $('#listEmployees .employeeCheckbox').length === $('#listEmployees .employeeCheckbox:checked').length;
            $('#selectAllEmployees').prop('checked', allChecked);
          });

          // Function to handle select all employees functionality
          function attachSelectAllEvent() {
            $('#selectAllEmployees').change(function () {
              var isChecked = $(this).is(':checked');
              $('#listEmployees input[type="checkbox"]').prop('checked', isChecked);
            });
          }

          $('#load').click(function () {
            // Show the loader and hide the button text
            $('.loader').show();
            $('.button-text').hide();
            var DepartmentName = $('#listDepartments').val();
            var startDate = $('#datepickerStart').val();
            var endDate = $('#datepickerEnd').val();
            var e = document.getElementById("listEmployees");
            var bioStarEmpStr = e.value;

            // Collect selected employees
            var selectedEmployees = [];
            $('#listEmployees  .employeeCheckbox:checked').each(function () {
              selectedEmployees.push($(this).val());
            });

            if (selectedEmployees.length === 0) {
              alert('Please select at least one employee.');
              $('.loader').hide();
              $('.button-text').show();
              return;
            }
            if (!startDate) {
              alert('Please select start date.');
              $('.loader').hide();
              $('.button-text').show();
              return;
            }

            if (!endDate) {
              alert('Please select end date.');
              $('.loader').hide();
              $('.button-text').show();
              return;
            }

            //alert(bioStarEmpStr)
             $.ajax({
                    url: "@Url.Action("AbsenteesData_UserWise", "AccessBiostarTA")",
               data: { 'startDate': startDate, 'endDate': endDate, 'DepartmentName': DepartmentName, 'bioStarEmpStr': selectedEmployees },
                    type: "POST",
                    cache: false,
                    success: function (data) {
                        //alert(data);
                        $("#NewData").html(data);
                        //$("#hdnOrigComments").val($('#txtComments').val());
                        //$('#lblCommentsNotification').text(savingStatus);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        //$('#lblCommentsNotification').text("Error encountered while saving the comments.");
                        alert('Data provided was not valid');
               },
               complete: function () {
                 // Hide the loader when the request is complete (success or error)
                 $('.loader').hide();
                 $('.button-text').show();
               }
             });
          });
        });


</script>

<style>

  .dropdown-check-list {
    display: inline-block;
    position: relative;
