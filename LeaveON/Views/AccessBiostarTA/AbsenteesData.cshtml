      border: 1px solid #767676;
      border-radius: 2px;
      width: 250px;
      height: 40px;
      text-overflow: ellipsis;
      text-align: center;
      display: flex;
      justify-content: center;
      align-items: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

  .employee-dropdown-width .anchor {
    /*padding: 0 177px 0 10px;*/
  }
