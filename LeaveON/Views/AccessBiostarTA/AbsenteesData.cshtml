    margin: 10px 5px;
  }

  .datepicker {
    width: 250px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }
  .ui-datepicker {
    width: 250px;
  }
  .department-drodown {
    text-align: left;
    padding-left: 15px;
    width: 250px;
  }

</style>

