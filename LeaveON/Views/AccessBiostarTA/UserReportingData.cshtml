<script type="text/javascript">

        $(document).ready(function () {
          //var currentDate = new Date()
          //var minDate = new Date(currentDate.getYear(), currentDate.getMonth() - 1); //previous month
          //var maxDate = new Date(currentDate.getFullYear(), currentDate.getMonth()); // this month
          //alert(currentDate);

          $('.datepicker').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 2,
            maxDate: new Date()
          });




          $("#listDepartments").change(function () {
            //DepartmentName = $('#yourslectbox').find(":selected").text();
            //alert('abc');
            var DepartmentName = $('#listDepartments').val();
            $("#listEmployees").empty();
            $.ajax({
              type: 'POST',
              url: "@Url.Action("GetThisDepEmpsData", "AccessBiostarTA")",
              dataType: 'json',
              data: { 'DepartmentName': DepartmentName },
              success: function (selDepEmps) {
                //alert(selDepEmps)
                $.each(selDepEmps, function (i, listEmployees) {
                  //alert(selDepEmps);
                  $("#listEmployees").append('<option value="' + listEmployees.Value + '">' + listEmployees.Text + '</option>');
            });
            },
              error: function (ex) {
              alert('Failed To Retive Products' + ex);
            }
            });
              return false;
          })



          $('#load').click(function () {
            var DepartmentName = $('#listDepartments').val();
            var startDate = $('#datepickerStart').val();
            var endDate = $('#datepickerEnd').val();
            var e = document.getElementById("listEmployees");
            var bioStarEmpStr = e.value;
            //alert(bioStarEmpStr)
             $.ajax({
                    url: "@Url.Action("AbsenteesData_UserWise", "AccessBiostarTA")",
               data: { 'startDate': startDate, 'endDate': endDate, 'DepartmentName': DepartmentName, 'bioStarEmpStr': bioStarEmpStr },
                    type: "GET",
                    cache: false,
                    success: function (data) {
                        //alert(data);
                        $("#NewData").html(data);

                        //$("#hdnOrigComments").val($('#txtComments').val());
                        //$('#lblCommentsNotification').text(savingStatus);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        //$('#lblCommentsNotification').text("Error encountered while saving the comments.");
                        alert('Data provided was not valid');
                    }
             });
          });
        });


</script>

