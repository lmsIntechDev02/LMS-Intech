<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<link rel="stylesheet" href="/resources/demos/style.css">
@*
  <script src="https://code.jquery.com/jquery-1.12.4.js"></script>*@
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<script type="text/javascript">

        $(document).ready(function () {
          // Initialize start date picker
          $('#datepickerStart').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 1,
            maxDate: new Date(),
            onSelect: function (selectedDate) {
              // Set minDate for the end date based on the selected start date
              $('#datepickerEnd').datepicker("option", "minDate", selectedDate);
              $('#datepickerEnd').prop('disabled', false);
            },
            onChangeMonthYear: function (year, month, inst) {
              // Keep the calendar open and update month/year selection
              var currentDate = $(this).datepicker('getDate') || new Date(year, month - 1, 1);
              currentDate.setFullYear(year);
              currentDate.setMonth(month - 1);
              $(this).datepicker("setDate", currentDate);
              var startDateValue = $('#datepickerStart').val();
              if (startDateValue) {
                $('#datepickerEnd').datepicker("option", "minDate", startDateValue);
                $('#datepickerEnd').prop('disabled', false);
              }
            }
          });

          // Initialize end date picker (disabled initially)
          $('#datepickerEnd').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 1,
            maxDate: new Date(),
            beforeShow: function (input, inst) {
              // Check if start date is selected
              var startDate = $('#datepickerStart').datepicker('getDate');
              if (startDate) {
                $(this).datepicker("option", "minDate", startDate);
              }
            },
            onSelect: function (selectedDate) {
              $(this).datepicker("hide"); // Close only when a date is selected
            },
            onChangeMonthYear: function (year, month, inst) {
              // Keep the calendar open on month/year change
              var currentDate = $(this).datepicker('getDate') || new Date(year, month - 1, 1);
              currentDate.setFullYear(year);
              currentDate.setMonth(month - 1);
              $(this).datepicker("setDate", currentDate);
            }
          }).prop('disabled', true);


          // Check if the start date is set and set the minDate for the end date
          var startDateValue = $('#datepickerStart').val();
          if (startDateValue) {
            $('#datepickerEnd').datepicker("option", "minDate", startDateValue);
            $('#datepickerEnd').prop('disabled', false);
          }

          // Close dropdown when clicking outside
          $(document).click(function (e) {
            if (!$(e.target).closest('.dropdown-check-list').length) {
              $(".dropdown-check-list").removeClass('visible');
            }
          })
     
          // Function to disable or enable inputs
          function disableInputs(isDisabled) {
            $('#load').prop('disabled', isDisabled);
            $('#listDepartments').prop('disabled', isDisabled);
            $('#datepickerStart').prop('disabled', isDisabled);
            $('#datepickerEnd').prop('disabled', isDisabled);
          }

          $('#load').click(function () {
            //show Loader
            $('.loader').show();
            $('.button-text').hide();
            $("#wait").css("display", "block");
            disableInputs(true);

            var CountryName = $('#listDepartments option:selected').text();
            var startDate = $('#datepickerStart').val();
            var endDate = $('#datepickerEnd').val();
            //var e = document.getElementById("listEmployees");
            //var bioStarEmpStr = e.value;
            //alert(bioStarEmpStr)
            if (!startDate) {
              alert('Please select start date.');
              $('.loader').hide();
              $('.button-text').show();
              $("#wait").css("display", "none");
              disableInputs(false);
              return;
            }

            if (!endDate) {
              alert('Please select end date.');
              $('.loader').hide();
              $('.button-text').show();
              $("#wait").css("display", "none");
              disableInputs(false);
              return;
            }
             $.ajax({
                    url: "@Url.Action("CountriesData", "AccessBiostarTA")",
               data: { 'startDate': startDate, 'endDate': endDate, 'CountryName': CountryName},
                    type: "GET",
                    cache: false,
                    success: function (data) {
                        $("#NewData").html(data);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        alert('Data provided was not valid');
               },
               complete: function () {
                 $('.loader').hide();
                 $('.button-text').show();
                 $("#wait").css("display", "none");
                 disableInputs(false);
               }
             });
          });
        });

</script>

<style>
  #load {
    display: inline-block;
    width: 100px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }

  .selectpicker {
    width: 250px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }
  .datepicker {
    width: 250px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }

</style>


