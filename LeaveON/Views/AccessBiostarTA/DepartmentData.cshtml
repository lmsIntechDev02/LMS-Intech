@model IEnumerable<TimeManagement.Models.UD_TB_AccessTime_Data>

@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
  @*Department Dropdown*@
  @Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartments), htmlAttributes: new { @class = "selectpicker", @id = "listDepartments", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })
 
  @*Month Dropdown*@
  @Html.DropDownList("selectMonth", (IEnumerable<SelectListItem>)ViewBag.MonthSelectList, htmlAttributes: new { @class = "selectpicker", @id = "selectMonth", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })
 
  <button id="load" style="position: relative;">
    <span class="button-text">Go</span>
    <span class="loader" style="display: none;">Loading...</span>
  </button>

  @{Html.RenderPartial("_UserData", Model); }
</div>
<script type="text/javascript">

        $(document).ready(function () {

          // Function to disable or enable inputs
          function disableInputs(isDisabled) {
            $('#load').prop('disabled', isDisabled);
            $('#listDepartments').prop('disabled', isDisabled);
            $('#selectMonth').prop('disabled', isDisabled);
          }

          $('#load').click(function () {
            var ReqMonthYear = $('#selectMonth').val();
            var DepartmentName = $('#listDepartments').val();
        
            $('.loader').show();
            $('.button-text').hide();
            disableInputs(true);

            if (DepartmentName === "") {
              alert("Department does not exist");
              $('.loader').hide();
              $('.button-text').show();
              disableInputs(false);
              return;
            }
           
             $.ajax({
                    url: "@Url.Action("DepartmentData","AccessBiostarTA")",
               data: { 'ReqMonthYear': ReqMonthYear, 'DepartmentName': DepartmentName },
                    type: "GET",
                    cache: false,
                    success: function (data) {
                        $("#NewData").html(data);
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        alert('Data provided was not valid');
                    },
               complete: function () {
                     // When request complete 
                     $('.loader').hide();
                     $('.button-text').show();
                     disableInputs(false);
               }
             });
          });
        });


</script>


<style>
  .selectpicker {
    width: 250px;
    height: 40px;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
    padding-left: 10px;
  }

  #load {
    display: inline-block;
    width: 100px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }
</style>
