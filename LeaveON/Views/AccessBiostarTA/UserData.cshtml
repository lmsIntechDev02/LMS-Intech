@model IEnumerable<LeaveON.UtilityClasses.TimeData>

@{ ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml"; }

<div>
  @if (User.IsInRole("Admin"))
  {
    // Department Dropdown for Admin (Multi-select)
    //@Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartments),
    //    htmlAttributes: new { @class = "selectpicker", @id = "listDepartments", data_live_search = "true", data_actions_box = "true", data_done_button = "true" }) // User Dropdown for Admin (Multi-select)
<div id="listDepartments" class="dropdown-check-list">
  <span class="anchor">Select Departments</span>
  <ul class="items">
    @foreach (var department in ViewBag.Departments as IEnumerable<SelectListItem>)
    {
<li>
  <label for="dept_@department.Value">
    <input type="checkbox" value="@department.Value" id="dept_@department.Value" /> @department.Text
  </label>
</li>
}
  </ul>
</div> @*    @Html.DropDownList("EmployeeList", new MultiSelectList(ViewBag.Employees, "Value", "Text", ViewBag.SelectedEmployees),
  htmlAttributes: new { @class = "selectpicker", @id = "listEmployees", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })*@

        <div id="listEmployees" class="dropdown-check-list employee-dropdown-width">
          <span class="anchor">Select Employees</span>
          <ul class="items">
            @foreach (var employee in ViewBag.Employees as IEnumerable<SelectListItem>)
            {
              var username = employee.Text.Split('@')[0]; // Get the part before the '@'
              username = username.Replace(".", " ");
    <li>
      <label for="emp_@employee.Value">
        <input type="checkbox" value="@employee.Value" id="emp_@employee.Value" /> @username
      </label>
    </li>
}
          </ul>
        </div> }
      else if (User.IsInRole("Manager"))
      {
        // Department Dropdown for Manager (Single department, disabled)
@Html.DropDownList("DepartmentList", new SelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartment),
                     htmlAttributes: new { @class = "selectpicker", @id = "listDepartments", @disabled = "disabled", data_live_search = "true", data_actions_box = "true", data_done_button = "true" }) // User Dropdown for Manager (Multi-select)
@Html.DropDownList("EmployeeList", new MultiSelectList(ViewBag.Employees, "Value", "Text", ViewBag.SelectedEmployees),
           htmlAttributes: new { @class = "selectpicker", @id = "listEmployees", data_live_search = "true", data_actions_box = "true", data_done_button = "true" }) }
else if (User.IsInRole("User"))
{
// Department Dropdown for User (Single department, disabled)
@Html.DropDownList("DepartmentList", new SelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartment),
           htmlAttributes: new { @class = "selectpicker", @id = "listDepartments", @disabled = "disabled", data_live_search = "true", data_actions_box = "true", data_done_button = "true" }) // User Dropdown for User (Single user, disabled)
@Html.DropDownList("EmployeeList", new SelectList(ViewBag.Employees, "Value", "Text", ViewBag.SelectedEmployees),
           htmlAttributes: new { @class = "selectpicker", @id = "selectedEmployees", @disabled = "disabled", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })}


  @Html.DropDownList("selectMonth", (IEnumerable<SelectListItem>)ViewBag.MonthSelectList, htmlAttributes: new { @class = "selectpicker", @id = "selectMonth", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })

  <button id="load">Go</button>

  @{ Html.RenderPartial("_UserData", Model); }
</div>

<script type="text/javascript">
  $(document).ready(function () {
 @*   $(".dropdown-check-list .anchor").click(function () {
      var checkList = $(this).parent();
      if (checkList.hasClass('visible')) {
        checkList.removeClass('visible');
      } else {
        checkList.addClass('visible');
      }
    });*@



    $(".dropdown-check-list .anchor").click(function (e) {
      var checkList = $(this).parent();
      checkList.toggleClass('visible');
      e.stopPropagation();
    });

    // Close dropdown when clicking outside
    $(document).click(function (e) {
      if (!$(e.target).closest('.dropdown-check-list').length) {
        $(".dropdown-check-list").removeClass('visible');
      }
    })

    // Load users based on the selected departments for Admin
    $('#listDepartments input[type="checkbox"]').change(function () {
      var selectedDepartments = [];
      $('#listDepartments input[type="checkbox"]:checked').each(function () {
        selectedDepartments.push($(this).val());
      });


      if (selectedDepartments.length === 0) {
        console.log('No departments selected.');
        return;
      }

              $.ajax({
            url: '@Url.Action("GetUsersByDepartments", "AccessBiostarTA")',
            type: 'POST',
             //   data: { 'departmentNames': selectedDepartments },
             //   data: { departmentNames: JSON.stringify(selectedDepartments) }, // Serialize array to JSON string
                contentType: 'application/json',
                data: JSON.stringify({ departmentNames: selectedDepartments }),

            success: function (data) {
              var employeeList = $("#listEmployees ul.items");
                employeeList.empty();
                $.each(data, function (index, item) {
                  employeeList.append($('<li>').html(
                    '<label for="emp_' + item.Value + '">' +
                    '<input type="checkbox" value="' + item.Value + '" id="emp_' + item.Value + '" /> ' +
                    item.Text +
                    '</label>'
                  ));
                });
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
                alert('Failed to load users');
            }
        });
        });
          $('#load').click(function () {
            var reqMonthYear = $('#selectMonth').val();
            var userRole = "@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "User")";
            var requestData;
            if (userRole === "Admin") {
              var selectedEmployees = [];
              $('#listEmployees input[type="checkbox"]:checked').each(function () {
                selectedEmployees.push($(this).val());
              });
              requestData = { 'ReqMonthYear': reqMonthYear, 'UserIds': selectedEmployees };
            } else if (userRole === "User") {
              var employeeId = $('#selectedEmployees').val();
              requestData = { 'ReqMonthYear': reqMonthYear, 'UserIds': employeeId };
            } else {
              var employeeId = $('#listEmployees').val();
              requestData = { 'ReqMonthYear': reqMonthYear, 'UserIds': employeeId};
            }
        
           // JSON.stringify(selectedEmployees)
              $.ajax({
                url: "@Url.Action("UserData", "AccessBiostarTA")",
                data: requestData,
                  type: "POST",
                  success: function (data) {
                    $("#NewData").html(data);
                    $('#listDepartments input[type="checkbox"]').prop('checked', false);
                    $('#listEmployees input[type="checkbox"]').prop('checked', false);
                  },
                  error: function (xhr, ajaxOptions, thrownError) {
                      alert('Data provided was not valid');
                  }
              });
          });
      });
</script>

<style>

  .dropdown-check-list {
    display: inline-block;
    position: relative;
    background-color: #ffffff;
  }

    .dropdown-check-list .anchor {
      position: relative;
      cursor: context-menu;
      display: inline-block;
      padding: 0 90px 0 10px;
      border: 1px solid #ccc;
      font-weight: normal;
      font-size: 14.8px;
      color: #000000;
      border: 1px solid #767676;
      border-radius: 2px;
    }

  .employee-dropdown-width .anchor {
    /*padding: 0 177px 0 10px;*/
  }
  .dropdown-check-list .anchor:after {
    position: absolute;
    content: "";
    border-left: 1.5px solid black;
    border-top: 1.5px solid black;
    padding: 3px;
    right: 10px;
    top: 30%;
    -moz-transform: rotate(-135deg);
    -ms-transform: rotate(-135deg);
    -o-transform: rotate(-135deg);
    -webkit-transform: rotate(-135deg);
    transform: rotate(-135deg);
  }

      .dropdown-check-list .anchor:active:after {
        right: 8px;
        top: 41%;
      }

    .dropdown-check-list ul.items {
      display: flex;
      align-items: baseline;
      padding: 2px;
      display: none;
      margin: 0;
      border: 1px solid #ccc;
      max-height: 570px;
      overflow-y: auto;
      border-top: none;
      background-color: white;
      position: absolute;
    @*  width: 100%;*@
      z-index: 1;
    }

      .dropdown-check-list ul.items li {
        list-style: none;
        padding: 5px;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-weight: normal;
      }
        .dropdown-check-list ul.items li label {
          font-weight: normal;
        }
        .dropdown-check-list ul.items li:hover {
          background-color: #0094ff;
        }

    .dropdown-check-list.visible .anchor {

    }

    .dropdown-check-list.visible .items {
      display: block;
    }

    .dropdown-check-list input[type="checkbox"] {
      margin-right: 10px;
    }

</style>



