@model IEnumerable<LeaveON.UtilityClasses.TimeData>

@{ ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml"; }


<div>

  <div class="row">
    <div class="col-12">

      <div class="d-flex justify-content-between align-items-center">

        <h3 class="dashboard-title my-2"> User List</h3>
       
      </div>

      <section class="content">
        <div class="card">
          <div class="row col-12 mt-3">

            @if (User.IsInRole("Admin"))
            {

              <div id="divDep" class="form-group col-3">
                <label class="font-weight-normal">Departments</label>
                @Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartments), htmlAttributes: new { @class = "form-control selectpicker", @id = "listDepartments", @multiple = "multiple", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })
              </div>

                      <div class="col-3">
                        <div id="ddlEmp">
                          @Html.Partial("_EmployeeList")
                        </div>
                      </div>
                    }
                    else if (User.IsInRole("Manager") || User.IsInRole("User"))
                    {



                      <div id="divDep" class="form-group col-3">
                        <label class="font-weight-normal">Departments</label>
                        @Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartments), htmlAttributes: new { @class = "form-control selectpicker", @id = "listDepartments", @multiple = "multiple", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })
                      </div>
                      <div class="col-3">
                        <div id="ddlEmp">
                          @Html.Partial("_EmployeeList")
                        </div>
                      </div>
                    }

            <div class="d-flex align-items-center gap-3 col-5 form-group">


              <div>
                <div>
                  <label class="font-weight-normal">Start Date</label>
                </div>
                @Html.Editor("startDate", new { htmlAttributes = new { @class = "datepicker", @id = "datepickerStart", @placeholder = "Start date", @Value = ViewBag.StartDate, autocomplete = "off" } })
              </div>

              @*@Html.Label("Time", htmlAttributes: new { @class = "control-label col-md-2" })*@
              <div>
                <div>
                  <label class="font-weight-normal">End Date</label>
                </div>
                @Html.Editor("endDate", new { htmlAttributes = new { @class = "datepicker", @id = "datepickerEnd", @placeholder = "End date", @Value = ViewBag.EndDate, autocomplete = "off" } })
              </div>
              <button id="load" style="position: relative;    top: 9px;">
                <span class="button-text">Go</span>
                <span class="loader" style="display: none;">Loading...</span>
              </button>

              <button id="ExportToExcel" style="position: relative;    top: 9px;">
                <span class="button-text">Export to  Excel</span>
                <span class="loader" style="display: none;">Loading...</span>
              </button>

            </div>
          </div>


          <div class="card-body">

            <div class="row">

              @*@{ Html.RenderPartial("_UserData", Model); }*@

              <table id="example2"
                     class="table table-bordered table-hover dataTable dtr-inline"
                     role="grid"
                     style="width:100%;">

                <thead>
                  <tr>
                    <th>
                      Employee Name
                    </th>

                    <th>
                      Employee Number
                    </th>

                    <th>
                      Department
                    </th>

                    <th>
                      Time Zone
                    </th>

                    <th>
                      Policy
                    </th>

                    <th>
                      Date
                    </th>

                    <th>
                      Day
                    </th>

                    <th>
                      Time In
                    </th>

                    <th>
                      Time Out
                    </th>

                    <th>
                      Working Hours
                    </th>

                    <th>
                      Total Time
                    </th>

                    <th>
                      Status
                    </th>

                    <th>
                      Action
                    </th>
                  </tr>
                </thead>

                <tbody>
                </tbody>

                <tfoot>
                  <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                    <td id="totalWorkingHours"
                        style="font-weight:bold;">
                      0 Hours
                    </td>

                    <td id="totalHours"
                        style="font-weight:bold;">
                      0 Hours
                    </td>

                    <td></td>
                    <td></td>
                  </tr>
                </tfoot>

              </table>
            </div>
          </div>
        </div>


      </section>

    </div>
  </div>
 
</div>

 
<link rel="stylesheet" href="/resources/demos/style.css">

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<script type="text/javascript">
  $(document).ready(function () {

    $('#datepickerStart').val('@ViewBag.StartDate');
    $('#datepickerEnd').val('@ViewBag.EndDate');
    $(".dropdown-check-list .anchor").click(function (e) {
      var checkList = $(this).parent();
      checkList.toggleClass('visible');
      e.stopPropagation();
    });


    // Initialize start date picker
    $('#datepickerStart').datepicker({
      dateFormat: 'dd-M-yy',
      changeMonth: true,
      changeYear: true,
      numberOfMonths: 1,
      maxDate: new Date(),
      onSelect: function (selectedDate) {
        // Set minDate for the end date based on the selected start date
        $('#datepickerEnd').datepicker("option", "minDate", selectedDate);
        $('#datepickerEnd').prop('disabled', false);
      },
      onChangeMonthYear: function (year, month, inst) {
        // Keep the calendar open and update month/year selection
        var currentDate = $(this).datepicker('getDate') || new Date(year, month - 1, 1);
        currentDate.setFullYear(year);
        currentDate.setMonth(month - 1);
        $(this).datepicker("setDate", currentDate);
        var startDateValue = $('#datepickerStart').val();
        if (startDateValue) {
          $('#datepickerEnd').datepicker("option", "minDate", startDateValue);
          $('#datepickerEnd').prop('disabled', false);
        }
      }
    });

    // Initialize end date picker (disabled initially)
    $('#datepickerEnd').datepicker({
      dateFormat: 'dd-M-yy',
      changeMonth: true,
      changeYear: true,
      numberOfMonths: 1,
      maxDate: new Date(),
      beforeShow: function (input, inst) {
        // Check if start date is selected
        var startDate = $('#datepickerStart').datepicker('getDate');
        if (startDate) {
          $(this).datepicker("option", "minDate", startDate);
        }
      },
      onSelect: function (selectedDate) {
        $(this).datepicker("hide"); // Close only when a date is selected
      },
      onChangeMonthYear: function (year, month, inst) {
        // Keep the calendar open on month/year change
        var currentDate = $(this).datepicker('getDate') || new Date(year, month - 1, 1);
        currentDate.setFullYear(year);
        currentDate.setMonth(month - 1);
        $(this).datepicker("setDate", currentDate);
      }
    }).prop('disabled', true);


    // Check if the start date is set and set the minDate for the end date
    var startDateValue = $('#datepickerStart').val();
    if (startDateValue) {
      $('#datepickerEnd').datepicker("option", "minDate", startDateValue);
      $('#datepickerEnd').prop('disabled', false);
    }

    // Close dropdown when clicking outside
    $(document).click(function (e) {
      if (!$(e.target).closest('.dropdown-check-list').length) {
        $(".dropdown-check-list").removeClass('visible');
      }
    })

    // Handle Select All functionality
    $('#selectAllEmployees').change(function () {
      var isChecked = $(this).is(':checked');
      $('#listEmployees .employeeCheckbox').prop('checked', isChecked);
    });

    // Handle individual checkbox changes to update "Select All" state
    $('#listEmployees').on('change', '.employeeCheckbox', function () {
      var allChecked = $('#listEmployees .employeeCheckbox').length === $('#listEmployees .employeeCheckbox:checked').length;
      $('#selectAllEmployees').prop('checked', allChecked);
    });


    // Function to handle select all employees functionality
    function attachSelectAllEvent() {
      $('#selectAllEmployees').change(function () {
        var isChecked = $(this).is(':checked');
        $('#listEmployees input[type="checkbox"]').prop('checked', isChecked);
      });
    }

    // Show alert if no employees exist
    $('#listEmployees .anchor').click(function () {
      if ($('#listEmployees ul.items li').length === 1) {
        alert("Data Not Exist");
        $('#listEmployees ul.items').css('display', 'none');
      }
    });

    // Function to disable or enable inputs
    function disableInputs(isDisabled) {
      $('#load').prop('disabled', isDisabled);
      $('#listDepartments input[type="checkbox"]').prop('disabled', isDisabled);
      $('#listEmployees input[type="checkbox"]').prop('disabled', isDisabled);
      $('#datepickerStart').prop('disabled', isDisabled);
      $('#datepickerEnd').prop('disabled', isDisabled);
    }
    $('#listDepartments').on('changed.bs.select', function (e, clickedIndex, isSelected, previousValue) {
    var selectedDepartments = $(this).val(); // this is an array of selected values
      console.log(selectedDepartments);
      debugger
    // If nothing is selected, send an empty array
    if (!selectedDepartments) {
        selectedDepartments = [];
    }

    $.ajax({
        url: '@Url.Action("GetUsersByDepartments", "AccessBiostarTA")',
        type: 'POST',
        contentType: 'application/json; charset=utf-8', // important
        data: JSON.stringify({ departmentNames: selectedDepartments }), // wrap array in object
        success: function (data) {
          //console.log('Users received:', data);
        //  alert(data)


          $("#ddlEmp").html(data)
          $('#idEmployees').selectpicker('refresh')
            // handle your data here
        },
        error: function (xhr, status, error) {
            console.error('Error:', error);
            alert('Failed to load users');
        }
    });
});


       $('#ExportToExcel').click(function () {
      // Show the loader and hide the button text



         //   var reqMonthYear = $('#selectMonth').val();
            var startDate = $('#datepickerStart').val();
            var endDate = $('#datepickerEnd').val();
            var userRole = "@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "User")";





            if (userRole === "Admin" || userRole === "Manager" || userRole === "User") {


              var selectedEmployees = $('#idEmployees option:selected').map(function () {
                return $(this).val();
              }).get();

              // Check if "on" is at index 0 and shift employee IDs
              //if (selectedEmployees[0] === "on") {
              //  selectedEmployees.shift();
              //}

                if (selectedEmployees.length === 0) {
                  if (userRole === "Admin")
                  {

                alert('Please select at least one department and one employee.');


                  return;
              }
              else
                  {



                alert('Please select at least one employee.');


                //disableInputs(false);
                  return;
                  }
                }
              if (!startDate) {
                alert('Please select start date.');

                disableInputs(false);
                return;
              }

              if (!endDate) {
                alert('Please select end date.');


                return;
              }
              //alert(selectedEmployees)

              //requestData = { 'StartDate': startDate, 'EndDate': endDate, 'UserIds': selectedEmployees };
              //location.href = "/AccessBiostarTA/ExportAttendance?StartDate=" + startDate + "&EndDate=" + endDate + "&UserIds" + selectedEmployees
              var url = "/AccessBiostarTA/ExportAttendance?StartDate=" + encodeURIComponent(startDate)
                + "&EndDate=" + encodeURIComponent(endDate);

              $.each(selectedEmployees, function (i, id) {
                url += "&UserIds=" + encodeURIComponent(id);
              });

              location.href = url;
            }

    })

     var attendanceTable = null;

$('#load').click(function () {
  debugger
    $('.loader').show();
    $('.button-text').hide();
    $("#wait").show();

    disableInputs(true);

    var startDate = $('#datepickerStart').val();
    var endDate = $('#datepickerEnd').val();

    var selectedEmployees = $('#idEmployees option:selected')
        .map(function () {
            return $(this).val();
        })
        .get();

  debugger
    // Remove "on"
    if (selectedEmployees.length > 0 &&
        selectedEmployees[0] === "on") {

        selectedEmployees.shift();
    }

    // Validation
    if (selectedEmployees.length === 0) {

        alert('Please select at least one employee.');

        hideLoader();
        return;
    }

    if (!startDate) {

        alert('Please select start date.');

        hideLoader();
        return;
    }

    if (!endDate) {

        alert('Please select end date.');

        hideLoader();
        return;
    }


    // Destroy existing DataTable
    if ($.fn.DataTable.isDataTable('#example2')) {

        $('#example2').DataTable().destroy();

        $('#example2 tbody').empty();
    }


    // Create DataTable
    attendanceTable = $('#example2').DataTable({

        processing: true,

        serverSide: true,

        searching: true,

        ordering: true,

        pageLength: 20,

        lengthMenu: [
            [10, 20, 50, 100],
            [10, 20, 50, 100]
        ],

        ajax: {

            url: '@Url.Action("GetAttendanceSummaryDT", "AccessBiostarTA")',

            type: 'POST',

            data: function (d) {

              d.formattedStartDate = startDate;

                d.formattedEndDate = endDate;

                d.UserIds = selectedEmployees;
            },

            dataSrc: function (json) {

                // Update totals returned from server
                $('#totalWorkingHours').text(
                    json.totalWorkingHours + ' Hours'
                );

                $('#totalHours').text(
                    json.totalHours + ' Hours'
                );

                return json.data;
            },

            error: function (xhr) {

              debugger
              console.log("Status:", status);
              console.log("Error:", error);
              console.log("Response:", xhr.responseText);

              alert(
                "Error: " +
                xhr.status +
                "\n\n" +
                xhr.responseText
              );
            },

            complete: function () {

                hideLoader();
            }
        },


        columns: [

            // Employee Name
            {
                data: "EmployeeName",
                name: "EmployeeName",

                render: function (data) {

                    if (!data)
                        return "";

                    return data.toLowerCase()
                        .replace(/\b\w/g, function (l) {
                            return l.toUpperCase();
                        });
                }
            },


            // Employee Number
            {
                data: "EmployeeNumber",
                name: "EmployeeNumber"
            },


            // Department
            {
                data: "Department",
                name: "Department"
            },


            // Time Zone
            {
                data: "TimeZone",
                name: "TimeZone"
            },


            // Policy
            {
                data: "Policy",
                name: "Policy"
            },


            // Date
            {
                data: "Date",
                name: "Date",

                render: function (data) {

                    if (!data)
                        return "";

                    var date = new Date(
                        parseInt(
                            data
                                .replace("/Date(", "")
                                .replace(")/", "")
                        )
                    );

                    return date.toLocaleDateString();
                }
            },


            // Day
            {
                data: "Day",
                name: "Day"
            },


            // Time In
            {
                data: "TimeIn",
                name: "TimeIn",

                render: function (data, type, row) {

                    if (!data)
                        return "-";

                    if (row.Status === "Absent")
                        return "-";

                    if (row.WorkingHours === "00:00:00")
                        return "-";

                    var date = new Date(
                        parseInt(
                            data
                                .replace("/Date(", "")
                                .replace(")/", "")
                        )
                    );

                    return date.toLocaleTimeString();
                }
            },


            // Time Out
            {
                data: "TimeOut",
                name: "TimeOut",

                render: function (data, type, row) {

                    if (!data)
                        return "-";

                    if (row.Status === "Absent")
                        return "-";

                    if (row.WorkingHours === "00:00:00")
                        return "-";

                    var date = new Date(
                        parseInt(
                            data
                                .replace("/Date(", "")
                                .replace(")/", "")
                        )
                    );

                    return date.toLocaleTimeString();
                }
            },


            // Working Hours
            {
                data: "WorkingHours",
                name: "WorkingHours",

                render: function (data, type, row) {

                    if (!data)
                        return "-";

                    if (row.Status === "Absent")
                        return "-";

                    if (data === "00:00:00")
                        return "-";

                    return data;
                }
            },


            // Total Time
            {
                data: "TotalTime",
                name: "TotalTime",

                render: function (data, type, row) {

                    if (!data)
                        return "-";

                    if (row.Status === "Absent")
                        return "-";

                    if (row.WorkingHours === "00:00:00")
                        return "-";

                    return data;
                }
            },


            // Status
            {
                data: "Status",
                name: "Status",

                render: function (data) {

                    return data || "";
                }
            },


            // Action
            {
                data: null,
                orderable: false,
                searchable: false,

                render: function (data, type, row) {

                    if (!row.EmployeeNumber)
                        return "";

                    if (row.WorkingHours === "00:00:00")
                        return "";

                    var date = formatDate(row.Date);

                    var url =
                        '@Url.Action("ConnectToDBandReturnOffHours", "AccessBiostarTA")'
                        + '?reqDate='
                        + encodeURIComponent(date)
                        + '&UserId='
                        + encodeURIComponent(row.EmployeeNumber);

                    return '<a href="' + url +
                           '" target="_blank">Break Hours</a>';
                }
            }
        ],


        // Default ordering by Date
        order: [
            [5, 'asc']
        ]
    });


    function formatDate(data) {

        if (!data)
            return "";

        var date = new Date(
            parseInt(
                data
                    .replace("/Date(", "")
                    .replace(")/", "")
            )
        );

        var day = String(date.getDate()).padStart(2, '0');

        var month = String(date.getMonth() + 1).padStart(2, '0');

        var year = date.getFullYear();

        return day + '-' + month + '-' + year;
    }


    function hideLoader() {

        $('.loader').hide();

        $('.button-text').show();

        $("#wait").hide();

        disableInputs(false);
    }

});
  });

</script>

<style>

