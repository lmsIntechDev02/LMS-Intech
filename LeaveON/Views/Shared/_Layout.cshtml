  <style>
    :root {
      --sb-bg: #141b24;
      --sb-text: #c3ccd6;
      --sb-text-muted: #6b7a8d;
      --sb-accent: #3b82f6;
      --sb-hover: rgba(255,255,255,0.05);
      --sb-active-bg: rgba(59,130,246,0.15);
      --sb-border: rgba(255,255,255,0.08);
    }

    .main-sidebar {
      background: var(--sb-bg) !important;
      display: flex;
      flex-direction: column;
    }

      .main-sidebar .sidebar {
        display: flex;
        flex-direction: column;
        height: calc(100% - 3.5rem);
        padding: 0;
      }

    .brand-link {
      border-bottom: 1px solid var(--sb-border) !important;
      padding: 16px !important;
    }

    /* search box */
    .sidebar-search-wrap {
      padding: 10px 12px;
    }

      .sidebar-search-wrap .input-group {
        background: rgba(255,255,255,0.05);
        border-radius: 8px;
        overflow: hidden;
      }

      .sidebar-search-wrap input {
        background: transparent;
        border: none;
        color: #fff;
        font-size: 12px;
        box-shadow: none !important;
      }

        .sidebar-search-wrap input::placeholder {
          color: var(--sb-text-muted);
        }

      .sidebar-search-wrap .input-group-text {
        background: transparent;
        border: none;
        color: var(--sb-text-muted);
      }

    .nav-sidebar .menu-open > .nav-link i.right {
      transform: rotate(90deg) !important;
    }
    /* nav scroll area */
    .sidebar-nav-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 2px 8px 8px;
    }

    .main-sidebar .nav-header {
      padding: 14px 10px 4px !important;
      font-size: 10px;
      color: #4d5a6b;
      letter-spacing: 0.6px;
      font-weight: 500;
      background: transparent !important;
      text-transform: uppercase;
    }

    .main-sidebar .nav-sidebar > .nav-item > .nav-link,
    .main-sidebar .nav-treeview > .nav-item > .nav-link {
      color: var(--sb-text) !important;
      border-radius: 7px !important;
      padding: 8px 10px !important;
      margin: 1px 4px;
    }

    .main-sidebar .nav-link:hover {
      background: var(--sb-hover) !important;
    }

    .main-sidebar .nav-link.active,
    .main-sidebar .nav-item.menu-open > .nav-link {
      background: var(--sb-active-bg) !important;
      border-left: 2px solid var(--sb-accent);
      color: #fff !important;
      font-weight: 500;
    }

    .main-sidebar .nav-icon {
      color: var(--sb-text-muted);
      font-size: 15px;
      margin-right: 8px;
    }

    .main-sidebar .nav-link.active .nav-icon,
    .main-sidebar .nav-link:hover .nav-icon {
      color: var(--sb-accent);
    }

    .main-sidebar .nav-treeview {
      background: transparent !important;
    }

      .main-sidebar .nav-treeview .nav-link {
        font-size: 14px !important;
        padding: 7px 10px 7px 34px !important;
        color: var(--sb-text-muted) !important;
      }

        .main-sidebar .nav-treeview .nav-link:hover {
          color: #fff !important;
        }

    .main-sidebar .badge-count {
      background: var(--sb-accent);
      color: #fff;
      font-size: 10px;
      font-weight: 500;
      border-radius: 20px;
      padding: 1px 6px;
      margin-left: auto;
    }

    /* footer user panel */
    .sidebar-footer-panel {
      border-top: 1px solid var(--sb-border);
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

      .sidebar-footer-panel .avatar-circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--sb-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 500;
        color: #fff;
        flex-shrink: 0;
      }

      .sidebar-footer-panel .footer-name {
        font-size: 12px;
        color: #fff;
        font-weight: 500;
        margin: 0;
      }

      .sidebar-footer-panel .footer-sub {
        font-size: 11px;
        color: var(--sb-text-muted);
        margin: 0;
      }

    .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active, .sidebar-light-primary .nav-sidebar > .nav-item > .nav-link.active {
      color: #fff !important;
    }
  </style>


</head>
