@{
  ViewBag.Title = "Error";
  Layout = "~/Views/Shared/_Layout.cshtml"; // Remove layout for this error page
}

<script>
  // Check if there's a previous page in the browser's history
  function showGoBackButton() {
    var backButton = document.getElementById("goBackButton");
    if (window.history.length > 1) {
      backButton.style.display = "inline-block";
    } else {
      backButton.style.display = "none";
    }
  }

  // Call the function when the page loads
  window.onload = showGoBackButton;
</script>

<div class="card-body">
  <div class="list-header clearfix">
    <span>Error</span>
  </div>

  <div class="list-sfs-holder">
    <div class="alert alert-error">
      @TempData["ErrorMessage"]
    </div>

    <a id="goBackButton" href="javascript:history.go(-1);" class="btn btn-primary" style="display: none;">Go Back</a>
  </div>
</div>
