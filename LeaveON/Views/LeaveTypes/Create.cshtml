@model LeaveON.Models.LeaveTypeModel

@{
  ViewBag.Title = "Create";
  Layout = "~/Views/Shared/_Layout.cshtml";
}




<!-- left column -->
<div class="col-md-6">
  <!-- general form elements -->
  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">Add Leave Types</h3>
    </div>
    <!-- /.card-header -->
    <!-- form start -->


    @using (Html.BeginForm("Create", "LeaveTypes", FormMethod.Post, new { role = "form" }))
    {

      @Html.AntiForgeryToken()

  <div class="card-body">

    @Html.HiddenFor(k => k.Id)

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
      @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = " " })

      @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
      @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

    </div>

    <div class="form-group">
      @Html.LabelFor(model => model.CountryIDs, "Country")
      <b style="color:red">*</b>

      @Html.ListBoxFor(
          model => model.CountryIDs,
          (MultiSelectList)ViewBag.CountryList,
          new
          {
              @class = "form-control selectpicker",
              @id = "listCountries",
              multiple = "multiple",
              data_live_search = "true",
              data_actions_box = "true",
              data_done_button = "true"
          }
      )
    </div>

    <div class="form-group">

      @Html.LabelFor(model => model.HrBPID, "HRBP", htmlAttributes: new { @class = " " })<b style="color:red">*</b>
      @Html.DropDownListFor(
    model => model.HrBPID,
    (IEnumerable<SelectListItem>)ViewBag.HrBPList,
    "Please select",
    new { @class = "form-control" }
)

    </div>

    <div class="form-group">
      @Html.CheckBoxFor(m => m.IsCalenderDays)
      @Html.LabelFor(m => m.IsCalenderDays, "Calender Days")
    </div>



    <div class="form-group">
      <div class="class=" card-footer">
        <input type="submit" value="Save" class="btn btn-primary" style="width: 180px; margin-left:auto;margin-right:auto;display:block;margin-top:auto;margin-bottom:0%" />
      </div>
    </div>
  </div>

    }

    <div>
      @Html.ActionLink("Back to List", "Index")
    </div>

    @*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@
  </div>
</div>
