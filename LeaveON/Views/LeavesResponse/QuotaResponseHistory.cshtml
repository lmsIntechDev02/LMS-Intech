@using Microsoft.AspNet.Identity

@{
  ViewBag.Title = "Quota Response History";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
  <div class="row">
    <div class="col-12">

      <div class="card">

        <div class="card-header">
          <h3 class="card-title">
            Users Compensatory Quota Approval Requests History
          </h3>
        </div>

        <div class="card-body">

          <!-- FILTER BUTTONS -->
          <div class="mb-3">

            <button type="button"
                    class="filter-btn active"
                    data-status="all">
              All
            </button>

            <button type="button"
                    class="filter-btn"
                    data-status="approved">
              Approved
            </button>

            <button type="button"
                    class="filter-btn"
                    data-status="rejected">
              Rejected
            </button>

            <button type="button"
                    class="filter-btn"
                    data-status="pending">
              Pending
            </button>

          </div>

          <!-- TABLE -->
          <table id="example2"
                 class="table table-bordered table-hover"
                 style="width:100%">

            <thead>
              <tr>
                <th>Request Date</th>
                <th>Email</th>
                <th>Joining Date</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Leave Type</th>
                <th>Total Days</th>
                <th>Reason</th>
                <th>Line Manager 1</th>
                <th>Line Manager 2</th>
                <th>Action</th>
              </tr>
            </thead>

          </table>

        </div>

      </div>

    </div>
  </div>
</section>

<script>

    $(document).ready(function () {

        var currentStatus = "all";

        var table = $('#example2').DataTable({

            processing: true,

            serverSide: true,

            searching: true,

            ordering: true,

            paging: true,

            pageLength: 10,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            responsive: true,

            order: [
                [0, "desc"]
            ],

            ajax: {
                url: '@Url.Action("GetQuotaResponseHistory", "LeavesResponse")',
                type: 'POST',

                data: function (d) {

                    d.status = currentStatus;

                }
            },

            columns: [

                {
                    data: "DateCreated",
                    name: "DateCreated"
                },

                {
                    data: "UserName",
                    name: "UserName"
                },

                {
                    data: "JoiningDate",
                    name: "JoiningDate"
                },

                {
                    data: "StartDate",
                    name: "StartDate"
                },

                {
                    data: "EndDate",
                    name: "EndDate"
                },

                {
                    data: "LeaveType",
                    name: "LeaveType"
                },

                {
                    data: "TotalDays",
                    name: "TotalDays"
                },

                {
                    data: "Reason",
                    name: "Reason"
                },

                {
                    data: "Manager1",
                    name: "Manager1",
                    orderable: false,
                    searchable: false
                },

                {
                    data: "Manager2",
                    name: "Manager2",
                    orderable: false,
                    searchable: false
                },

                {
                    data: "Action",
                    name: "Action",
                    orderable: false,
                    searchable: false
                }

            ]

        });


        // ----------------------------------------
        // FILTER BUTTON
        // ----------------------------------------

        $('.filter-btn').on('click', function () {

            $('.filter-btn').removeClass('active');

            $(this).addClass('active');

            currentStatus = $(this).data('status');

            // Reload from server
            table.ajax.reload(null, true);

        });

    });

</script>

<style>

  .filter-btn {
    color: #000;
    background-color: #fff;
    border: 1px solid #c5c5c5;
    padding: 6px 12px;
    width: 110px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    margin-right: 7px;
  }

    .filter-btn:hover {
      background-color: #e0e0e0;
      border: 1px solid #000;
    }

    .filter-btn.active {
      background-color: #f1f1f1;
      border: 1px solid #000;
      font-weight: 600;
    }
</style>
