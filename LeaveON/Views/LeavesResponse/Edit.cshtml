    $('#sendResponse').click(function (event) {
      event.preventDefault(); // Prevent the default form submission momentarily
      handleFormSubmission(event, 'loader', 'sendResponse', this.form); // Pass the form to the function
    });

    function handleFormSubmission(event, loaderId, buttonId, form) {
      var loader = document.getElementById(loaderId);
      var button = document.getElementById(buttonId);
      button.disabled = true;
      loader.style.display = 'block'; // Show the loader

      setTimeout(function () { // Optional: delay for showing the loader
        form.submit(); // Submit the form explicitly
      }, 1000); // Adjust time as necessary for showing the loader
    }
  });
</script>



