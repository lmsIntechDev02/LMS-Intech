 
@model IEnumerable<LeaveON.Models.Procedures.LeaveAbsentModel>

@{ ViewBag.Title = "Leave/Absent";
  Layout = "~/Views/Shared/_Layout.cshtml"; }
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/css/bootstrap-select.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/js/bootstrap-select.min.js"></script>
<div>

  <div class="row">

    @if (User.IsInRole("Admin"))
    {


  <div id="divDep" class="form-group col-3">
    <label class="font-weight-normal">Departments</label>
    @Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text"), htmlAttributes: new { @class = "form-control selectpicker", @id = "listDepartments", @multiple = "multiple", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })
  </div>


          <div class="col-3">

            <div id="ddlEmp">

              @Html.Partial("~/Views/AccessBiostarTA/_EmployeeList.cshtml")
            </div>

          </div> }
                else if (User.IsInRole("Manager") || User.IsInRole("User"))
                {



          <div id="divDep" class="form-group col-3">
            <label class="font-weight-normal">Departments</label>
            @Html.DropDownList("DepartmentList", new MultiSelectList(ViewBag.Departments, "Value", "Text", ViewBag.SelectedDepartments), htmlAttributes: new { @class = "form-control selectpicker", @id = "listDepartments", @multiple = "multiple", data_live_search = "true", data_actions_box = "true", data_done_button = "true" })
          </div>
                  <div class="col-3">
                    <div id="ddlEmp">

                      @Html.Partial("~/Views/AccessBiostarTA/_EmployeeList.cshtml")
                    </div>
                  </div>}


    <div class="d-flex align-items-center gap-3 col-6 form-group">


      <div>
        <div>
          <label class="font-weight-normal">Start Date</label>
        </div>
        @Html.Editor("startDate", new { htmlAttributes = new { @class = "datepicker", @id = "datepickerStart", @placeholder = "Start date", @Value = ViewBag.StartDate, autocomplete = "off" } })
      </div>

       
      <div>
        <div>
          <label class="font-weight-normal">End Date</label>
        </div>
        @Html.Editor("endDate", new { htmlAttributes = new { @class = "datepicker", @id = "datepickerEnd", @placeholder = "End date", @Value = ViewBag.EndDate, autocomplete = "off" } })
      </div>
      <button id="load" style="position: relative;    top: 9px;">
        <span class="button-text">Go</span>
        <span class="loader" style="display: none;">Loading...</span>
      </button>

    </div>
  </div>
  <div class="row">
    <div id="wait" style="display:none;"><img src='~/Images/Ripple_1s_200px_Transparent.gif' width="38" height="38" /></div>
    @{ Html.RenderPartial("_LeaveAbsentReport", Model); }
  </div>
</div>

@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css" integrity="sha512-ELV+xyi8IhEApPS/pSj66+Jiw+sOT1Mqkzlh8ExXihe4zfqbWkxPRi8wptXIO9g73FSlhmquFlUOuMSoXz5IRw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js" integrity="sha512-57oZ/vW8ANMjR/KQ6Be9v/+/h6bq9/l3f0Oc7vn6qMqyhvPd1cvKBRWWpzu0QoneImqr2SkmO4MSqU+RpHom3Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>*@

<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<link rel="stylesheet" href="/resources/demos/style.css">

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<script type="text/javascript">
  $(document).ready(function () {


    //$('.ddlMembershipCategory').selectpicker('val', OfferMembershipCategories);
    $('#datepickerStart').val('@ViewBag.StartDate');
    $('#datepickerEnd').val('@ViewBag.EndDate');
    $(".dropdown-check-list .anchor").click(function (e) {
      var checkList = $(this).parent();
      checkList.toggleClass('visible');
      e.stopPropagation();
    });


    // Initialize start date picker
    $('#datepickerStart').datepicker({
      dateFormat: 'dd-M-yy',
      changeMonth: true,
      changeYear: true,
      numberOfMonths: 1,
      maxDate: new Date(),
      onSelect: function (selectedDate) {
        // Set minDate for the end date based on the selected start date
        $('#datepickerEnd').datepicker("option", "minDate", selectedDate);
        $('#datepickerEnd').prop('disabled', false);
      },
      onChangeMonthYear: function (year, month, inst) {
        // Keep the calendar open and update month/year selection
        var currentDate = $(this).datepicker('getDate') || new Date(year, month - 1, 1);
        currentDate.setFullYear(year);
        currentDate.setMonth(month - 1);
        $(this).datepicker("setDate", currentDate);
        var startDateValue = $('#datepickerStart').val();
        if (startDateValue) {
          $('#datepickerEnd').datepicker("option", "minDate", startDateValue);
          $('#datepickerEnd').prop('disabled', false);
        }
      }
    });

    // Initialize end date picker (disabled initially)
    $('#datepickerEnd').datepicker({
      dateFormat: 'dd-M-yy',
      changeMonth: true,
      changeYear: true,
      numberOfMonths: 1,
      maxDate: new Date(),
      beforeShow: function (input, inst) {
        // Check if start date is selected
        var startDate = $('#datepickerStart').datepicker('getDate');
        if (startDate) {
          $(this).datepicker("option", "minDate", startDate);
        }
      },
      onSelect: function (selectedDate) {
        $(this).datepicker("hide"); // Close only when a date is selected
      },
      onChangeMonthYear: function (year, month, inst) {
        // Keep the calendar open on month/year change
        var currentDate = $(this).datepicker('getDate') || new Date(year, month - 1, 1);
        currentDate.setFullYear(year);
        currentDate.setMonth(month - 1);
        $(this).datepicker("setDate", currentDate);
      }
    }).prop('disabled', true);


    // Check if the start date is set and set the minDate for the end date
    var startDateValue = $('#datepickerStart').val();
    if (startDateValue) {
      $('#datepickerEnd').datepicker("option", "minDate", startDateValue);
      $('#datepickerEnd').prop('disabled', false);
    }

    






    $('#listDepartments').on('changed.bs.select', function (e, clickedIndex, isSelected, previousValue) {
    var selectedDepartments = $(this).val(); // this is an array of selected values
    console.log(selectedDepartments);

    // If nothing is selected, send an empty array
    if (!selectedDepartments) {
        selectedDepartments = [];
      }
      debugger
    $.ajax({
        url: '@Url.Action("GetUsersByDepartments", "AccessBiostarTA")',
        type: 'POST',
        contentType: 'application/json; charset=utf-8', // important
        data: JSON.stringify({ departmentNames: selectedDepartments }), // wrap array in object
        success: function (data) {
          //console.log('Users received:', data);
        //  alert(data)


          $("#ddlEmp").html(data)
          $('#idEmployees').selectpicker('refresh')
            // handle your data here
        },
        error: function (xhr, status, error) {
            console.error('Error:', error);
            alert('Failed to load users');
        }
    });
});




    $('#load').click(function () {
      debugger
      // Show the loader and hide the button text
      $('.loader').show();
      $('.button-text').hide();
      $("#wait").css("display", "block");
     // disableInputs(true);

            var reqMonthYear = $('#selectMonth').val();
            var startDate = $('#datepickerStart').val();
            var endDate = $('#datepickerEnd').val();
            var userRole = "@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "User")";
            var requestData;




            if (userRole === "Admin" || userRole === "Manager" || userRole === "User") {


              var selectedEmployees = $('#idEmployees option:selected').map(function () {
                return $(this).val();
              }).get();




                if (selectedEmployees.length === 0) {
                  if (userRole === "Admin")
                  {

                alert('Please select at least one department and one employee.');
                $('.loader').hide();
                $('.button-text').show();
                $("#wait").css("display", "none");
                disableInputs(false);
                  return;
              }
              else
                  {



                alert('Please select at least one employee.');
                $('.loader').hide();
                $('.button-text').show();
                $("#wait").css("display", "none");

                disableInputs(false);
                  return;
                  }
                }
              if (!startDate) {
                alert('Please select start date.');
                $('.loader').hide();
                $('.button-text').show();
                $("#wait").css("display", "none");
                disableInputs(false);
                return;
              }

              if (!endDate) {
                alert('Please select end date.');
                $('.loader').hide();
                $('.button-text').show();
                $("#wait").css("display", "none");
                disableInputs(false);
                return;
              }

              requestData = { 'startDate': startDate, 'endDate': endDate, 'userIds': selectedEmployees };
            }
            else if (userRole === "User")
            {
              var employeeId = $('#selectedEmployees').val();
              requestData = { 'ReqMonthYear': reqMonthYear, 'UserIds': employeeId };
            }
            @*else {
              var employeeId = $('#listEmployees').val();
              requestData = { 'ReqMonthYear': reqMonthYear, 'UserIds': employeeId};
            }*@
      
           // JSON.stringify(selectedEmployees)
              $.ajax({
                url: "@Url.Action("GetLeaveAbsentReport", "LeavesResponse")",
                data: requestData,
                  type: "POST",
                success: function (data)
                {
                    $("#NewData").html(data);
                  },
                  error: function (xhr, ajaxOptions, thrownError) {
                      alert('Data provided was not valid');
                },
                complete: function () {
                  // Hide the loader when the request is complete (success or error)
                  $('.loader').hide();
                  $('.button-text').show();
                  $("#wait").css("display", "none");
                  disableInputs(false);
                }
              });
          });
      });
</script>

<style>

  .dropdown-check-list {
    display: inline-block;
    position: relative;
    background-color: #ffffff;
    width: 250px;
    height: 40px;
    margin: 10px 5px;
  }

    .dropdown-check-list .anchor {
      position: relative;
      cursor: context-menu;
      display: inline-block;
      padding: 0 50px 0 10px;
      border: 1px solid #ccc;
      font-weight: normal;
      font-size: 14.8px;
      color: #000000;
      border: 1px solid #767676;
      border-radius: 2px;
      width: 250px;
      height: 40px;
      text-overflow: ellipsis;
      text-align: center;
      display: flex;
      justify-content: center;
      align-items: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

  .employee-dropdown-width .anchor {
    /*padding: 0 177px 0 10px;*/
  }
  .dropdown-check-list .anchor:after {
    position: absolute;
    content: "";
    border-left: 1.5px solid black;
    border-top: 1.5px solid black;
    padding: 3px;
    right: 10px;
    top: 30%;
    -moz-transform: rotate(-135deg);
    -ms-transform: rotate(-135deg);
    -o-transform: rotate(-135deg);
    -webkit-transform: rotate(-135deg);
    transform: rotate(-135deg);
  }

      .dropdown-check-list .anchor:active:after {
        right: 8px;
        top: 41%;
      }

  .dropdown-check-list ul.items {
    display: flex;
    align-items: baseline;
    padding: 2px;
    display: none;
    margin: 0;
    border: 1px solid #ccc;
    max-height: 570px;
    width: 250px;
    overflow-y: auto;
    border-top: none;
    background-color: white;
    position: absolute;
    @*  width: 100%;*@
    z-index: 1;
  }

      .dropdown-check-list ul.items li {
        list-style: none;
        padding: 5px;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-weight: normal;
      }
        .dropdown-check-list ul.items li label {
          font-weight: normal;
        }
        .dropdown-check-list ul.items li:hover {
          background-color: #0094ff;
        }

    .dropdown-check-list.visible .anchor {

    }

    .dropdown-check-list.visible .items {
      display: block;
    }

    .dropdown-check-list input[type="checkbox"] {
      margin-right: 10px;
    }

  #load {
    display: inline-block;
    width: 100px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }

  .selectpicker {
    width: 200px;
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
  }

  .datepicker {
     width: 250px; 
    height: 40px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 10px 5px;
    margin-top: 0px;
    border-radius: 4px;
    border: 1px solid #000000;
    background: #f8f9fa;
    position: relative;
    top: 0px;
  } 
  .ui-datepicker {
    width: 250px;
  }
    .bootstrap-select.form-control{
      border:1px solid  !important;
      height:auto !important;
   

</style>



