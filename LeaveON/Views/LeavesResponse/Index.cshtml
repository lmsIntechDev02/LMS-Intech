@model IEnumerable<Repository.Models.Leave>
@using Microsoft.AspNet.Identity
@using System.Web.Mvc.Html

@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- DataTables -->
 
@if (TempData["ErrorMessage"] != null)
{
  <script>
        toastr.error("@TempData["ErrorMessage"]");
  </script>
}
<section class="content">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center my-2">

       
        <h3 class="dashboard-title my-2">Users Leave Approval Requests History</h3>

      </div>
      <div class="card">
        


        <div class="card-body">
          <div class="mb-3 d-flex gap-2">
            <button id="btnAll" class="filter-btn active" data-status="all">All</button>
            <button id="btnApproved" class="filter-btn " data-status="approved">Approved</button>
            <button id="btnRejected" class="filter-btn" data-status="rejected">Rejected</button>
            <button id="btnPending" class="filter-btn" data-status="pending">Pending</button>
          </div>

          <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
            <div class="row">
              <div class="col-sm-12 col-md-6">
              </div>
              <div class="col-sm-12 col-md-6"></div>
            </div>
            <div class="row">
              <div class="col-sm-12">
                <table id="example2"
                       class="table table-bordered table-hover"
                       style="width:100%">

                  <thead>
                    <tr>
                      <th>Request Date</th>
                      <th>Email</th>
                      <th>Joining Date</th>
                      <th>Start Date</th>
                      <th>End Date</th>
                      <th>Leave Type</th>
                      <th>Total Days</th>
                      <th>Reason</th>
                      <th>Line Manager 1</th>
                      <th>Line Manager 2</th>
                      <th>Action</th>
                    </tr>
                  </thead>

                </table>



              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>



<!-- page script -->
<script>

    $(document).ready(function () {

        var currentStatus = "all";
        var table = $('#example2').DataTable({

            processing: true,
            serverSide: true,

            ajax: {
                url: '@Url.Action("GetLeaveApprovalHistory", "LeavesResponse")',
                type: 'POST',

                data: function (d) {
                    d.status = currentStatus;
                }
            },

            pageLength: 10,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            searching: true,
            ordering: true,
            responsive: true,

            order: [
                [0, 'desc']
            ],

            columns: [

                {
                    data: 'DateCreated',
                    name: 'DateCreated'
                },

                {
                    data: 'UserName',
                    name: 'UserName'
                },

                {
                    data: 'JoiningDate',
                    name: 'JoiningDate'
                },

                {
                    data: 'StartDate',
                    name: 'StartDate'
                },

                {
                    data: 'EndDate',
                    name: 'EndDate'
                },

                {
                    data: 'LeaveType',
                    name: 'LeaveType'
                },

                {
                    data: 'TotalDays',
                    name: 'TotalDays'
                },

                {
                    data: 'Reason',
                    name: 'Reason'
                },

                {
                    data: 'Manager1',
                    name: 'Manager1',
                    orderable: false,
                    searchable: false
                },

                {
                    data: 'Manager2',
                    name: 'Manager2',
                    orderable: false,
                    searchable: false
                },

                {
                    data: 'Action',
                    name: 'Action',
                    orderable: false,
                    searchable: false
                }

            ]

        });


        // ------------------------------------
        // Status Filter
        // ------------------------------------

        $('.filter-btn').on('click', function () {

            $('.filter-btn').removeClass('active');

            $(this).addClass('active');

            currentStatus = $(this).data('status');

            table.ajax.reload();

        });

    });

</script>


<style>
  .filter-btn {
    color: #000;
    border: 1px solid #c5c5c5;
    padding: 6px 12px;
    width: 110px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    margin-left: 7px;
  }

    .filter-btn:hover {
      background-color: #e0e0e0;
      border: 1px solid #000;
    }

    .filter-btn.active {
      border: 1px solid #000;
    }
</style>

