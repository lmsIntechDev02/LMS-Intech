
@model IEnumerable<LeaveON.Models.Procedures.LeaveAbsentModel>
@using System.Globalization

@{

  <div id="NewData" class="w-100">
    <!-- DataTables -->
    <link rel="stylesheet" href="../../plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">

    <!-- DataTables -->
    <script src="../../plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="../../plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <section class="content">

      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Leave/Absent Data</h3>


        </div>


        <div class="card-body">

          <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
            <div class="row">
              <div class="col-sm-12 col-md-6">
              </div>
              <div class="col-sm-12 col-md-6"></div>
            </div>
            <div class="row">
              <div class="col-sm-12">
                @if (!(Model is null))
                {
                  TimeSpan AllWorkingHours = new TimeSpan();
                  TimeSpan AllTotalTime = new TimeSpan();
                  <table id="example2" class="table table-bordered table-hover dataTable dtr-inline" role="grid" aria-describedby="example2_info">
                    <thead>
                      <tr>
                        <th>
                          Employee Name
                        </th>
                        <th>
                          Emp ID
                        </th>
                        <th>
                          Department
                        </th>
                        <th>

                          Date
                        </th>
                        <th>

                          Day
                        </th>
                        <th>
                          Leasve/Absent
                        </th>
                        <th>
                        Leave Start
                        </th>
                        <th>
                          Leave End
                        </th>
                        <th>
                         Total Days
                        </th>
                        <th>
                        Reason
                        </th>
                        <th>
                        Line Manager 1
                        </th>
                        <th>
                          Line Manager 1
                        </th>
                        <th>
                         Status 
                        </th>
                        @*<th></th>*@
                      </tr>
                    </thead>
                    <tbody>
                      @foreach (var item in Model)
                      {
                        <tr>
                          <td>
                            @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(item.EmployeeName.ToLower())
                          </td>
                          <td>
                            @Html.DisplayFor(modelItem => item.BioStarEmpNum)
                          </td>
                          <td>
                            @Html.DisplayFor(modelItem => item.DepartmentName)
                          </td>
                          <td>
                            @Html.DisplayFor(modelItem => item.DateCreated)
                          </td>
                          <td>
                            @Html.DisplayFor(modelItem => item.DayName)
                          </td>
                          <td>
                            @Html.DisplayFor(modelItem => item.LeaveTypeName)
                          </td>
                          
                          @{  

                              if (item.Status == "Leave")
                              {
                              <td>
                                @Html.DisplayFor(modelItem => item.LeaveStartDate)
                              </td>
                              <td>
                                @Html.DisplayFor(modelItem => item.LeaveEndDate)
                              </td>
                              <td>
                                @Html.DisplayFor(modelItem => item.TotalDays)
                              </td>
                              <td>
                                @Html.DisplayFor(modelItem => item.Reason)
                              </td>
                            }
                            else
                            {
                              <td>
                                <text>-</text>
                              </td>
                              <td>
                                <text>-</text>
                              </td>
                              <td>
                                <text>-</text>
                              </td>
                              <td>
                                <text>-</text>
                              </td>
                            }

                          }

                          <td>

                           
                              @Html.DisplayFor(modelItem => item.Status)
                            


                          </td>
                        </tr>
                      }
                    </tbody>
                    @*<tfoot>
                      <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td style="font-weight:bold">@ViewBag.TotalWorkingHours Hours</td>
                        <td style="font-weight:bold">@ViewBag.TotalHours Hours</td>
                        <td></td>
                      </tr>
                    </tfoot>*@
                  </table>

                }



              </div>
            </div>
          </div>
        </div>
      </div>


    </section>
  </div>
}
<script>
    $.fn.dataTable.ext.type.order['date-uk-pre'] = function (date) {
      var parts = date.split('-');
    return new Date(parts[2], parts[1] - 1, parts[0]).getTime();
  };

    $(function () {
      $('#example2').DataTable({
        "paging": false,
        "lengthChange": false,
        "searching": true,
        "ordering": true,
        "info": false,
        "autoWidth": false,
        "responsive": true,
        "order": [[6, "asc"]],
        "columnDefs": [
          { "type": "date-uk", "targets": 6 }
        ]
      });
  });
</script>


