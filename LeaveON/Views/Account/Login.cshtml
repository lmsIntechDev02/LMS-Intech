@using LeaveON.Models

@model LoginViewModel

@{

  ViewBag.Title = "Sign In";

  Layout = "~/Views/Shared/_LayoutAnonymous.cshtml";

}

<div class="login-wrapper">

  <div class="login-card">

    <!-- Logo -->
    <div class="text-center mb-4">

      <img src="~/dist/img/INTECH.png" class="login-logo" alt="Company Logo" />
      <h5 class="mt-3">Sign In</h5>

    </div>

    @using (Html.BeginForm("Login", "Account",

        new { returnUrl = ViewBag.ReturnUrl },

        FormMethod.Post,

        new { autocomplete = "off", id = "accountLogin" }))

    {

      @Html.AntiForgeryToken()



      <div class="form-group mb-3">

        <div class="input-group">

          <span class="input-group-text">
            <i class="fas fa-envelope"></i>
          </span>

          @Html.TextBoxFor(m => m.Email,

          new

          {

              @class = "form-control",

              placeholder = "Email Address"

          })

        </div>

        @Html.ValidationMessageFor(m => m.Email, "",

            new { @class = "text-danger" })

      </div>

      <div class="form-group mb-0">

        <div class="input-group">

          <span class="input-group-text">
            <i class="fas fa-lock"></i>
          </span>

          @Html.PasswordFor(m => m.Password,

          new

          {

              @class = "form-control",

              placeholder = "Password"

          })

        </div>

        @Html.ValidationMessageFor(m => m.Password, "",

            new { @class = "text-danger" })

      </div>
      <div class="mb-3"> @Html.ValidationSummary(true, "", new { @class = "text-danger" })</div>

              <button type="submit"
                      class="btn btn-primary w-100 login-btn">
                <i class="fas fa-sign-in-alt"></i>

                Sign In
              </button>

            }

  </div>

</div>
<style>

  body {
    background: linear-gradient(135deg,#0d6efd,#4e73df);
    font-family: 'Segoe UI',sans-serif;
  }

  .login-wrapper {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .login-card {
    width: 420px;
    background: #fff;
    border-radius: 15px;
    padding: 40px;
    box-shadow: 0 15px 35px rgba(0,0,0,.18);
  }
  ul {
    margin-top: 0;
    padding-left: 1rem !important;
    margin-bottom: 0rem;
  }
  .login-logo {
    width: 110px;
    height: auto;
  }
    .input-group-text {
    background: #f5f6fa;
    border-right: none;
  }

  .form-control {
    border-left: none;
    height: 48px;
  }

    .form-control:focus {
      box-shadow: none;
      border-color: #86b7fe;
    }

  .login-btn {
    height: 48px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
  }

    .login-btn:hover {
      transform: translateY(-2px);
      transition: .3s;
    }

  .text-danger {
    font-size: 13px;
  }

  h2 {
    font-weight: 700;
  }
</style>
