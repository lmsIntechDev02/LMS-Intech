@model  LeaveON.Models.UserModel

@{
  ViewBag.Title = "Edit";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- left column -->
<div class="col-md-6">
  <!-- general form elements -->
  <div class="card card-primary">
    <div class="card-header">
      <h3 class="card-title">Update User</h3>
    </div>
    <!-- /.card-header -->
    <!-- form start -->


    @using (Html.BeginForm())
    {
      @Html.AntiForgeryToken()




  <div class="card-body">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

 

    <div class="form-group">
      <div class="row">
        <div class="col-md-8">
          <div class="form-group">
            @Html.LabelFor(model => model.Email, "Email", htmlAttributes: new { @class = " " })

            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
          </div>
        </div>
        <div class="col-md-8">

          @if (ViewBag.UserAnnualLeaveBalance != null && ViewBag.UserAnnualLeaveBalance > 0)
          {
       
            <button type="button" class="btn btn-primary" id="btlAnulaBalance">
              View Annual Leave Balance
            </button>
          }
        </div>
      </div>


    </div>

    
    <div class="form-group">
      @Html.LabelFor(model => model.UserName, "User Name", htmlAttributes: new { @class = " " })

      @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
      @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })

    </div>
    <div class="form-group">
      @Html.LabelFor(model => model.ManagerID, "Manager", htmlAttributes: new { @class = " " })

      @Html.DropDownList("ManagerID", (IEnumerable<SelectListItem>)ViewBag.LineManagers, "Please select manager", new { @class = "form-control" })
      @Html.ValidationMessageFor(model => model.ManagerID, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
      @Html.LabelFor(model => model.Manager2ID, "2nd Manager", htmlAttributes: new { @class = " " })

      @Html.DropDownList("Manager2ID", (IEnumerable<SelectListItem>)ViewBag.LineManagers, "Please select manager", new { @class = "form-control" })
      @Html.ValidationMessageFor(model => model.Manager2ID, "", new { @class = "text-danger" })
    </div>
     
    <div class="form-group">
      @Html.LabelFor(model => model.Gender, "Gender", htmlAttributes: new { @class = " " })

      @Html.DropDownList("Gender", null, htmlAttributes: new { @class = "form-control" })

      @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">

      @Html.Label("HRBP")
      @Html.DropDownListFor(model => model.HRBPID,
          (SelectList)ViewBag.HRBPEmailList,
          "Please Select HRBP Manger",
          new { @class = "form-control" })
      @Html.ValidationMessageFor(model => model.HRBPID, "", new { @class = "text-danger" })

    </div>



    <div class="form-group">

      @Html.LabelFor(model => model.DepartmentName, "Department", htmlAttributes: new { @class = " " })

      @Html.DropDownList("DepartmentName", (IEnumerable<SelectListItem>)ViewBag.Departments, null, new { @class = "form-control" })

      @Html.ValidationMessageFor(model => model.DepartmentName, "", new { @class = "text-danger" })

    </div>

    <div class="form-group">
      @Html.LabelFor(model => model.CountryName, "Country", htmlAttributes: new { @class = " " })

      @*@Html.DropDownList("CntryName", new MultiSelectList(ViewBag.CountryNames, "Value", "Text"), htmlAttributes: new { @class = "form-control", @disabled = "disabled" })*@
      @Html.EditorFor(model => model.CntryName, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
      @Html.ValidationMessageFor(model => model.CountryName, "", new { @class = "text-danger" })

    </div>

    <div class="form-group">
      

      @Html.Label("If Employee is temporarily relocated to some other country please check and select that to show correct attendance data", htmlAttributes: new { @class = " " })
      @Html.CheckBoxFor(model => model.IsRelocated, new { htmlAttributes = new { @class = "form-control" } })

      @Html.DropDownList("CntryNameTemp", new MultiSelectList(ViewBag.CountryNames, "Value", "Text"), htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
 
      @Html.ValidationMessageFor(model => model.CntryNameTemp, "", new { @class = "text-danger" })

    </div>
     


    <div class="form-group">
      @Html.LabelFor(model => model.UserLeavePolicyId, "LeavePolicy", htmlAttributes: new { @class = " " })

      @Html.DropDownList("UserLeavePolicyId", null, htmlAttributes: new { @class = "form-control" })
      @Html.ValidationMessageFor(model => model.UserLeavePolicyId, "", new { @class = "text-danger" })

    </div>


    <div class="form-group">
      @Html.LabelFor(model => model.BioStarEmpNum, "BioStarEmpNum", htmlAttributes: new { @class = " " })

      @Html.EditorFor(model => model.BioStarEmpNum, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
      @Html.ValidationMessageFor(model => model.BioStarEmpNum, "", new { @class = "text-danger" })

    </div>

     

    <div class="form-group">
      @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = " " })

      @Html.EditorFor(model => model.Remarks, new { htmlAttributes = new { @class = "form-control" } })
      @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })

    </div>
    <div class="form-group">
      <div class="class=" card-footer">
        <input type="submit" value="Save" class="btn btn-primary" style="width: 180px; margin-left:auto;margin-right:auto;display:block;margin-top:auto;margin-bottom:0%" />
      </div>
    </div>
    <div>
      @Html.ActionLink("Back to List", "Index")
    </div>
  </div>


    }


  </div>
</div>
<div class="modal fade" id="annualLeaveModal" tabindex="-1" aria-labelledby="annualLeaveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="annualLeaveModalLabel">
          Annual Leave Balance
        </h5>
         
      </div>

      <div class="modal-body">

        <div class="form-group ">

          <label> Available  Annual leave</label>

          <input type="text" disabled="disabled" class="form-control" value="@ViewBag.UserAnnualLeaveBalance" />
          <input type="hidden" id="anualLeaveBalance"  value="@ViewBag.UserAnnualLeaveBalance" />


        </div>
        <div class="form-group">

          <label>Adjust Annual Leave</label>
       
          <input type="text" id="txtCaryAmount" class="form-control" value="@ViewBag.UserAnnualLeaveBalance" />

    

        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          Close
        </button>
        <button type="button" class="btn btn-primary btnSaveCarryAmount"  >
          Save 
        </button>
      </div>

    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  $(document).ready(function ()
  {
     


    if ($("#IsRelocated").prop('checked')) {
      $('#CntryNameTemp').removeAttr('disabled');
    }
    //else {
    //  $('#CntryNameTemp').val($('#CntryName').val());
    //}

    $("#IsRelocated").click(function () {

      if ($(this).prop('checked')) {
        $('#CntryNameTemp').removeAttr('disabled');
      } else {
        $('#CntryNameTemp').attr('disabled', 'disabled');
      }
    });


    $("#btlAnulaBalance").click(function () {
      $('#annualLeaveModal').modal('show');
    });


    $(document).on("click", ".btnSaveCarryAmount", function () {
      debugger
      var userId = $("#Id").val();
      var carryAmount = $("#txtCaryAmount").val();
      var balance = $("#anualLeaveBalance").val();
      const adjustment = parseFloat(carryAmount);
      const availableBalance = parseFloat(balance);

      if (carryAmount == '' || carryAmount == undefined)
      {
        Swal.fire({
          title: "warning",
          text: "Please enter leave balance.",
          icon: "warning"
        });
        return false;
      }
      if (isNaN(adjustment) )
      {
        Swal.fire({
          title: "Warning",
          text: "Please enter a valid leave balance..",
          icon: "warning"
        });

        return false;
      }

      if ( adjustment <=0) {
        Swal.fire({
          title: "Warning",
          text: "Leave balance should be greater than > 0.",
          icon: "warning"
        });

        return false;
      }
    
      

    $.ajax({
        url: '@Url.Action("SaveCarryAmount", "AspNetUsers")',
        type: 'POST',
        data: {
            userId: userId,
            carryAmount: carryAmount
        },
        success: function (response) {
            if (response.success) {
              Swal.fire({

                text: response.message,
                icon: "success",
                showCancelButton: false,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ok"
              }).then((result) => {
                if (result.isConfirmed)
                {
                  location.reload();
                }
              });

            } else {
             // alert(response.message);
              Swal.fire({
                title: "Error",
                text: response.message,
                icon: "error"
              });
            }
        },
        error: function () {
 
          Swal.fire({
            title: "Error",
            text: "An error occurred.",
            icon: "error"
          });
        }
    });

});
  });


</script>


