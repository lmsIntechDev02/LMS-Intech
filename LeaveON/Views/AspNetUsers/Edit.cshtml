<script>
  $(document).ready(function () {
    
    if ($("#IsRelocated").prop('checked')) {
      $('#CntryNameTemp').removeAttr('disabled');
    }
    //else {
    //  $('#CntryNameTemp').val($('#CntryName').val());
    //}

    $("#IsRelocated").click(function () {

      if ($(this).prop('checked')) {
        $('#CntryNameTemp').removeAttr('disabled');
      } else {
        $('#CntryNameTemp').attr('disabled', 'disabled');
      }
    });
  });
</script>


