@model IEnumerable<Repository.Models.AspNetUser>

@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- DataTables CSS -->
 
<style>
  .user-action-icons {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 5px;
    white-space: nowrap !important;
  }

    .user-action-icons a {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      text-decoration: none;
    }

      .user-action-icons a:hover {
        text-decoration: none;
      }
</style>





<section class="content">
  <div class="row">
    <div class="col-12">
      <div>

        <h3 class="dashboard-title my-2">User List </h3>
      </div>
      <div class="card">



        <div class="card-body">
          @*@Html.ActionLink("Register User", "Register","Account")*@
          <div d="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
            <div class="row">
              <div class="col-sm-12 col-md-6">
              </div>
              <div class="col-sm-12 col-md-6"></div>
            </div>
            <div class="row">
              <div class="col-sm-12">
                <table id="example2"
                       class="table table-bordered table-hover"
                       style="width:100%;">

                  <thead>
                    <tr>
                      <th>Emp. Id</th>
                      <th>User Name</th>
                      <th>Manager</th>
                      <th>Manager ID</th>
                      <th>Manager 2</th>
                      <th>Department</th>
                      <th>Country</th>
                      <th>Relocated Country</th>
                      <th>Leave Policy</th>
                      <th>Date Created</th>
                      <th>Date Modified</th>
                      <th>Remarks</th>
                      <th>Action</th>
                    </tr>
                  </thead>

                  <tbody>
                    <!-- DataTables will load data here -->
                  </tbody>

                </table>




              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="leaveDetailModal" tabindex="-1" role="dialog"
       aria-labelledby="leaveDetailModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title" id="leaveDetailModalLabel">
            Leave Detail
          </h5>

          <button type="button" class="close" data-dismiss="modal"
                  aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body" id="leaveDetailContent">

          @*<div class="text-center" id="leaveDetailLoader">
            <span>Loading...</span>
          </div>*@

        </div>

      </div>
    </div>
  </div>

</section>

 



<!-- page script -->
<script>
$('#example2').DataTable({
    processing: true,
    serverSide: true,

    ajax: {
        url: '@Url.Action("GetUsers", "AspNetUsers")',
        type: 'POST'
    },

    pageLength: 10,

    lengthMenu: [
        [10, 25, 50, 100],
        [10, 25, 50, 100]
    ],

    searching: true,
    ordering: true,
    responsive: true,
    autoWidth: false,

    order: [[1, 'asc']],

  dom:
    "<'row'" +
    "<'col-sm-6 d-flex align-items-center justify-conten-start'l>" +
    "<'col-sm-6 d-flex align-items-center justify-content-end'fB>" +
    ">" +

    "<'table-responsive'tr>" +

    "<'row'" +
    "<'col-sm-12 col-md-5 d-flex align-items-center justify-content-center justify-content-md-start'i>" +
    "<'col-sm-12 col-md-7 d-flex align-items-center justify-content-center justify-content-md-end'p>" +
    ">",

    buttons: [
      {
        extend: 'excel',
        text: 'Export to Excel',
        className: 'btn btn-primary ml-2'
      }
    ],

    columns: [
        {
            data: 'BioStarEmpNum'
        },
        {
            data: 'UserName'
        },
        {
            data: 'ManagerName'
        },
        {
          data: 'ManagerID'
        },
        {
            data: 'Manager2Name'
        },
        {
            data: 'DepartmentName'
        },
        {
            data: 'CntryName'
        },
        {
            data: 'CntryNameTemp'
        },
        {
            data: 'LeavePolicy'
        },
      {
        data: 'DateCreated',
        render: function (data, type, row) {
          debugger
          if (!data) {
            return '';
          }


          var timestamp = parseInt(data.replace(/[^0-9]/g, ''), 10);
          var date = new Date(timestamp);

          return ('0' + date.getDate()).slice(-2) + '/' +
            ('0' + (date.getMonth() + 1)).slice(-2) + '/' +
            date.getFullYear();
        }
      },
      {
        data: 'DateModified',
        render: function (data, type, row) {

          if (!data) {
            return '';
          }

          var timestamp = parseInt(data.replace(/[^0-9]/g, ''), 10);
          var date = new Date(timestamp);

          return ('0' + date.getDate()).slice(-2) + '/' +
            ('0' + (date.getMonth() + 1)).slice(-2) + '/' +
            date.getFullYear();
        }
      },
        {
            data: 'Remarks'
        },
        {
            data: null,
            orderable: false,
            searchable: false,
         render: function (data, type, row) {

    return '<div class="user-action-icons">' +

        '<a href="@Url.Action("Edit", "AspNetUsers")/' + row.Id +
        '" title="Update User" ' +
        'class="btn btn-outline-primary btn-sm">' +
        '<i class="fas fa-edit"></i>' +
        '</a>' +

        '<a href="javascript:;" ' +
        'class="btn btn-outline-primary btn-sm btnUserleaveDetail" ' +
        'user-id="' + row.Id + '" ' +
        'user-leaveid="' + row.UserLeavePolicyId + '" ' +
        'title="Leave Detail">' +
        '<i class="fas fa-calendar-alt"></i>' +
        '</a>' +

        '</div>';
}
        }
    ]
});


  $(document).on("click", ".btnUserleaveDetail", function () {
    debugger
    var userId = $(this).attr("user-id");
    var userLeaveid = $(this).attr("user-leaveid");

    if (userLeaveid == null || userLeaveid == undefined) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'There is no policy defined for that user.',
        confirmButtonText: 'OK'
      });
      return false;
    }


    $.ajax({
        url: '@Url.Action("Edit", "UserLeavePolicies")',
        type: 'GET',
        data: {

          leaveUserId: userId,
          id: userLeaveid,
          Caller: "LeaveRequest",
         IsUserDetail:true
        },
        success: function (response) {

          $("#leaveDetailModal").modal("show");
            $("#leaveDetailContent").html(response);

        },
        error: function (xhr) {

            // Close modal
            $("#leaveDetailModal").modal("hide");

            // SweetAlert error message
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Unable to load leave details. Please try again.',
                confirmButtonText: 'OK'
            });

            console.log(xhr.responseText);
        }
    });

});
</script>
